<section class="law-page">
  <header class="law-header" data-reveal>
    <a class="law-back" href="/">← Back to EasySupport</a>
    <p class="eyebrow">Legal</p>
    <h1>Impressum</h1>
    <p class="law-date">Provider information</p>
  </header>

  <article class="law-body" data-reveal>
    <div class="impressum-content" id="impressum-content">
      <h2>Angaben gemäß § 5 TMG</h2>
      <p><strong>Provider:</strong> <%= providerName %></p>
      <% if (providerAddress) { %><p><strong>Address:</strong> <%= providerAddress %></p><% } %>
      <% if (providerPhone) { %><p><strong>Phone:</strong> <%= providerPhone %></p><% } %>
      <p><strong>Email:</strong> <%= providerEmail %></p>
      <% if (tradeRegister) { %><p><strong>Trade Register:</strong> <%= tradeRegister %></p><% } %>
      <% if (vatId) { %><p><strong>VAT ID:</strong> <%= vatId %></p><% } %>
      <p><small><%= impressumContent %></small></p>
    </div>
    <p class="law-contact">
      <a href="/privacy">Datenschutz</a> ·
      <a href="/terms">AGB</a>
    </p>
  </article>
</section>
