<section class="legal-page" data-reveal>
  <header class="legal-page__header">
    <h1>Legal notice</h1>
    <p class="legal-page__meta">Information under § 5 TMG (German Telemedia Act)</p>
  </header>

  <article class="legal-page__content">
    <section>
      <h2>Service provider</h2>
      <address>
        <%= cfg.impressumProviderName || 'EasySupport' %><br>
        <%= cfg.impressumProviderAddress || '123 Example Street' %><br>
        <%= cfg.impressumProviderCity || '12345 Example City' %><br>
        <%= cfg.impressumProviderCountry || 'Germany' %>
      </address>
    </section>

    <section>
      <h2>Contact</h2>
      <% if (cfg.impressumProviderEmail) { %>
        <p>Email: <a href="mailto:<%= cfg.impressumProviderEmail %>"><%= cfg.impressumProviderEmail %></a></p>
      <% } %>
      <% if (cfg.impressumProviderPhone) { %>
        <p>Phone: <%= cfg.impressumProviderPhone %></p>
      <% } %>
    </section>

    <section>
      <h2>Person responsible for content</h2>
      <p><%= cfg.impressumProviderName || 'EasySupport' %><br>
      <%= cfg.impressumProviderAddress || '123 Example Street' %><br>
      <%= cfg.impressumProviderCity || '12345 Example City' %></p>
    </section>

    <% if (cfg.impressumTradeRegister || cfg.impressumVatId) { %>
    <section>
      <h2>Trade register / VAT ID</h2>
      <% if (cfg.impressumTradeRegister) { %><p>Trade register: <%= cfg.impressumTradeRegister %></p><% } %>
      <% if (cfg.impressumVatId) { %><p>Value added tax identification number: <%= cfg.impressumVatId %></p><% } %>
    </section>
    <% } %>

    <section>
      <h2>Disclaimer</h2>
      <h3>Liability for content</h3>
      <p>The content of these pages has been created with the greatest care. However, we cannot guarantee the correctness, completeness, or timeliness of the content.</p>

      <h3>Liability for links</h3>
      <p>Our offer contains links to external third-party websites over whose content we have no control. Therefore, we cannot accept any liability for this external content.</p>
    </section>

    <section>
      <h2>Copyright</h2>
      <p>The content and works on these pages created by the site operators are protected by copyright law.</p>
    </section>

    <section>
      <h2>Data privacy</h2>
      <p>The use of our website is generally possible without providing personal data. Where personal data is collected on our pages, this is done, as far as possible, on a voluntary basis.</p>
    </section>
  </article>

  <footer class="legal-page__footer">
    <p>Last updated: <time datetime="2026-01-01">January 2026</time></p>
    <p><a href="/">← Back to home</a></p>
  </footer>
</section>