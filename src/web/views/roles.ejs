<section class="permissions-page" data-guild-id="<%= guildId %>">
  <header class="page-intro page-intro--row" data-reveal>
    <div>
      <p class="eyebrow">Access control · <%= guildName %></p>
      <h1>Staff permissions.</h1>
      <p>Choose which commands each Discord role can use. Guild administrators always bypass these settings.</p>
    </div>
    <a class="button button--quiet" href="/dashboard/<%= guildId %>">Back to overview <span aria-hidden="true">↗</span></a>
  </header>

  <% if (!roles || roles.length === 0) { %>
    <div class="empty-panel" data-reveal>
      <h2>No assignable roles were found.</h2>
      <p>Create a role in Discord and return here to configure its command access.</p>
    </div>
  <% } else { %>
    <div class="permission-toolbar" data-reveal>
      <div class="permission-toolbar__copy">
        <strong><%= roles.length %> roles</strong>
        <span><%= commands.length %> commands · changes save as you go</span>
      </div>
      <div class="module-search permission-search">
        <label class="sr-only" for="permission-search">Search roles or commands</label>
        <span class="module-search__icon" aria-hidden="true"></span>
        <input id="permission-search" type="search" placeholder="Search roles or commands" autocomplete="off" data-permission-search>
      </div>
    </div>

    <div class="role-matrix" data-role-matrix>
      <div class="role-matrix__table">
        <table class="matrix-table">
          <caption class="sr-only">Staff role command permissions</caption>
          <thead>
            <tr>
              <th class="matrix-cell--role" scope="col">Guild role</th>
              <% commands.forEach((cmd) => { %>
                <th class="matrix-cell--cmd" scope="col" data-command-column="<%= cmd %>"><code>/<%= cmd %></code></th>
              <% }) %>
            </tr>
          </thead>
          <tbody>
            <% roles.forEach((role) => { %>
              <tr data-role-row data-role-name="<%= role.name %>">
                <th class="matrix-cell--role" scope="row">
                  <span class="role-chip" style="--role-color: #<%= role.color.toString(16).padStart(6, '0') %>"><%= role.name %></span>
                </th>
                <% commands.forEach((cmd) => { %>
                  <td class="matrix-cell--perm" data-command-cell="<%= cmd %>">
                    <label class="permission-toggle" data-role="<%= role.id %>" data-cmd="<%= cmd %>">
                      <input type="checkbox" aria-label="Allow /<%= cmd %> for <%= role.name %>" <%= role.perms[cmd] ? 'checked' : '' %>>
                      <span class="permission-toggle__track" aria-hidden="true"><span></span></span>
                    </label>
                  </td>
                <% }) %>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="search-empty" data-permission-empty hidden>No matching roles or commands.</p>
    </div>

    <div class="permission-legend" id="role-permissions-help">
      <span><i class="permission-legend__allowed" aria-hidden="true"></i> Allowed</span>
      <span><i class="permission-legend__denied" aria-hidden="true"></i> Denied</span>
      <p>Unchecked commands are denied to the selected role. Existing unset permissions default to allowed.</p>
      <p class="sr-only" data-permission-status role="status" aria-live="polite"></p>
    </div>
  <% } %>
</section>
