<section class="module-settings">
  <header class="page-heading">
    <div>
      <p class="section-kicker">Moderation</p>
      <h1>Moderation settings</h1>
      <p>Configure warn, mute, ban, timeout, and logging options.</p>
    </div>
    <a href="/dashboard/<%= guildId %>" class="button button--quiet">← Back to guild</a>
  </header>

  <form method="post" action="/admin/modules/<%= guildId %>/moderation" class="settings-form">
    <div class="settings-grid">
      <% 
      const fields = [
        { key: 'mod_log_channel', label: 'Mod Log Channel', type: 'channel', desc: 'Channel for moderation action logs' },
        { key: 'mute_role', label: 'Mute Role', type: 'role', desc: 'Role applied when a user is muted' },
        { key: 'default_mute_duration', label: 'Default Mute Duration', type: 'number', desc: 'Default duration when no duration specified', unit: 'min' },
        { key: 'warn_threshold', label: 'Warn Threshold', type: 'number', desc: 'Warnings before automatic action' },
        { key: 'auto_mute_on_warns', label: 'Auto Mute on Warns', type: 'toggle', desc: 'Automatically mute when threshold reached' },
        { key: 'log_deletions', label: 'Log Deletions', type: 'toggle', desc: 'Log deleted messages' },
        { key: 'log_edits', label: 'Log Edits', type: 'toggle', desc: 'Log message edits' },
        { key: 'log_member_actions', label: 'Log Member Actions', type: 'toggle', desc: 'Log joins, leaves, bans' },
        { key: 'mod_command_channel', label: 'Mod Command Channel', type: 'channel', desc: 'Channel where mod commands can be used' },
      ];
      fields.forEach((s) => { %>
        <div class="setting-field">
          <label class="setting-label" for="<%= s.key %>"><%= s.label %></label>
          <p class="setting-desc"><%= s.desc %></p>
          <% if (s.type === 'toggle') { %>
            <div class="toggle">
              <input type="checkbox" id="<%= s.key %>" name="<%= s.key %>" value="true" <%= settings[s.key] === 'true' || settings[s.key] === true ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </div>
          <% } else if (s.type === 'number') { %>
            <div class="input-group">
              <input type="number" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>" min="0">
              <span class="input-suffix"><%= s.unit %></span>
            </div>
          <% } else if (s.type === 'role') { %>
            <select id="<%= s.key %>" name="<%= s.key %>">
              <option value="">Select a role</option>
              <% roles.forEach((role) => { %>
                <option value="<%= role.id %>" <%= settings[s.key] === role.id ? 'selected' : '' %>><%= role.name %></option>
              <% }) %>
              <% if (settings[s.key] && !roles.some((role) => role.id === settings[s.key])) { %>
                <option value="<%= settings[s.key] %>" selected>Saved role is unavailable</option>
              <% } %>
            </select>
          <% } else if (s.type === 'channel') { %>
            <select id="<%= s.key %>" name="<%= s.key %>">
              <option value="">Select a channel</option>
              <% channels.forEach((channel) => { %>
                <option value="<%= channel.id %>" <%= settings[s.key] === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
              <% }) %>
              <% if (settings[s.key] && !channels.some((channel) => channel.id === settings[s.key])) { %>
                <option value="<%= settings[s.key] %>" selected>Saved channel is unavailable</option>
              <% } %>
            </select>
          <% } else { %>
            <input type="text" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>">
          <% } %>
        </div>
      <% }) %>
    </div>
    <div class="form-actions">
      <button type="submit" class="button button--primary">Save moderation settings</button>
    </div>
  </form>
</section>

<style>
.module-settings { max-width: 900px; margin: 0 auto; padding: 24px; }
.page-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32px; }
.page-heading > div { flex: 1; }
.section-kicker { color: var(--muted); font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; margin-bottom: 8px; }
.page-heading h1 { font-size: 28px; color: var(--ink); margin-bottom: 4px; letter-spacing: -0.04em; }
.page-heading p { color: var(--muted); font-size: 15px; }
.settings-form { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 32px; }
.settings-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px; }
.setting-field { display: flex; flex-direction: column; gap: 8px; }
.setting-label { font-size: 14px; font-weight: 700; color: var(--ink); }
.setting-desc { font-size: 12px; color: var(--muted); margin: 0; }
.toggle { position: relative; display: inline-flex; align-items: center; gap: 10px; cursor: pointer; font-size: 14px; color: var(--ink); }
.toggle input { opacity: 0; width: 0; height: 0; pointer-events: none; }
.toggle-slider { width: 44px; height: 24px; border-radius: 12px; background: var(--surface-raised); border: 2px solid var(--line); transition: all 160ms ease; }
.toggle input:checked + .toggle-slider { background: var(--accent); border-color: var(--accent); }
.input-group { display: flex; align-items: center; gap: 8px; }
.input-group input { flex: 1; }
.input-suffix { font-size: 13px; color: var(--muted); font-weight: 600; }
input[type="text"], input[type="number"] { width: 100%; padding: 10px 14px; background: var(--surface-quiet); border: 1px solid var(--line); border-radius: 8px; color: var(--ink); font-size: 14px; }
input[type="text"]:focus, input[type="number"]:focus { outline: none; border-color: var(--accent); }
.field-hint { font-size: 11px; color: var(--muted); margin-top: 4px; }
.form-actions { margin-top: 32px; display: flex; justify-content: flex-end; }
@media (max-width: 640px) { .module-settings { padding: 16px; } .settings-form { padding: 20px; } .settings-grid { grid-template-columns: 1fr; } .page-heading { flex-direction: column; align-items: flex-start; gap: 16px; } }
</style>