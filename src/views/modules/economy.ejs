<section class="module-settings">
  <header class="page-heading">
    <div>
      <p class="section-kicker">Economy</p>
      <h1>Economy settings</h1>
      <p>Configure balances, daily rewards, shop, and transactions.</p>
    </div>
    <a href="/dashboard/<%= guildId %>" class="button button--quiet">← Back to guild</a>
  </header>

  <form method="post" action="/admin/modules/<%= guildId %>/economy" class="settings-form">
    <div class="settings-grid">
      <% 
      const fields = [
        { key: 'economy_enabled', label: 'Economy Enabled', type: 'toggle', desc: 'Enable economy features for this server' },
        { key: 'daily_amount', label: 'Daily Amount', type: 'number', desc: 'Amount given by daily command' },
        { key: 'daily_cooldown', label: 'Daily Cooldown', type: 'number', desc: 'Hours between daily claims', unit: 'hr' },
        { key: 'work_amount', label: 'Work Amount', type: 'number', desc: 'Amount earned per work command' },
        { key: 'work_cooldown', label: 'Work Cooldown', type: 'number', desc: 'Minutes between work commands', unit: 'min' },
        { key: 'pay_enabled', label: 'Pay Enabled', type: 'toggle', desc: 'Allow users to pay each other' },
        { key: 'shop_enabled', label: 'Shop Enabled', type: 'toggle', desc: 'Enable the server shop' },
        { key: 'currency_name', label: 'Currency Name', type: 'text', desc: 'Name of the currency (e.g. Credits)' },
        { key: 'currency_emoji', label: 'Currency Emoji', type: 'text', desc: 'Emoji used for the currency' },
        { key: 'starting_balance', label: 'Starting Balance', type: 'number', desc: 'Balance given to new users' },
      ];
      fields.forEach((s) => { %>
        <div class="setting-field">
          <label class="setting-label" for="<%= s.key %>"><%= s.label %></label>
          <p class="setting-desc"><%= s.desc %></p>
          <% if (s.type === 'toggle') { %>
            <div class="toggle">
              <input type="checkbox" id="<%= s.key %>" name="<%= s.key %>" value="true" <%= settings[s.key] === 'true' || settings[s.key] === true ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </div>
          <% } else if (s.type === 'number') { %>
            <div class="input-group">
              <input type="number" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>" min="0">
              <span class="input-suffix"><%= s.unit || '' %></span>
            </div>
          <% } else { %>
            <input type="text" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>">
          <% } %>
        </div>
      <% }) %>
    </div>
    <div class="form-actions">
      <button type="submit" class="button button--primary">Save economy settings</button>
    </div>
  </form>
</section>
