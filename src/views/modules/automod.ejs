<section class="module-settings">
  <header class="page-heading">
    <div>
      <p class="section-kicker">Automod</p>
      <h1>Automod settings</h1>
      <p>Configure word filters, link filters, mention spam, and caps filter.</p>
    </div>
    <a href="/dashboard/<%= guildId %>" class="button button--quiet">← Back to guild</a>
  </header>

  <form method="post" action="/admin/modules/<%= guildId %>/automod" class="settings-form">
    <div class="settings-grid">
      <% 
      const fields = [
        { key: 'word_filter_enabled', label: 'Word Filter', type: 'toggle', desc: 'Block messages containing blocked words' },
        { key: 'blocked_words', label: 'Blocked Words', type: 'text', desc: 'Comma-separated list of blocked words' },
        { key: 'link_filter_enabled', label: 'Link Filter', type: 'toggle', desc: 'Block messages containing links' },
        { key: 'allowed_domains', label: 'Allowed Domains', type: 'text', desc: 'Comma-separated domains that are allowed' },
        { key: 'mention_spam_enabled', label: 'Mention Spam', type: 'toggle', desc: 'Block excessive mentions' },
        { key: 'mention_spam_threshold', label: 'Mention Threshold', type: 'number', desc: 'Max mentions before action' },
        { key: 'caps_filter_enabled', label: 'Caps Filter', type: 'toggle', desc: 'Block excessive capital letters' },
        { key: 'caps_threshold', label: 'Caps Threshold', type: 'number', desc: 'Max caps ratio (0-1)' },
        { key: 'max_line_length', label: 'Max Line Length', type: 'number', desc: 'Maximum characters per line' },
        { key: 'automod_action', label: 'Default Action', type: 'select', desc: 'Action on automod violation', options: ['none','delete','mute','kick'] },
      ];
      fields.forEach((s) => { %>
        <div class="setting-field">
          <label class="setting-label" for="<%= s.key %>"><%= s.label %></label>
          <p class="setting-desc"><%= s.desc %></p>
          <% if (s.type === 'toggle') { %>
            <div class="toggle">
              <input type="checkbox" id="<%= s.key %>" name="<%= s.key %>" value="true" <%= settings[s.key] === 'true' || settings[s.key] === true ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </div>
          <% } else if (s.type === 'number') { %>
            <div class="input-group">
              <input type="number" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>" min="0">
            </div>
          <% } else if (s.type === 'select') { %>
            <select id="<%= s.key %>" name="<%= s.key %>">
              <% s.options.forEach((opt) => { %>
                <option value="<%= opt %>" <%= settings[s.key] === opt ? 'selected' : '' %>> <%= opt %></option>
              <% }) %>
            </select>
          <% } else { %>
            <input type="text" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>">
            <span class="field-hint">Comma-separated values</span>
          <% } %>
        </div>
      <% }) %>
    </div>
    <div class="form-actions">
      <%- include('../partials/save-button', { settingName: 'automod' }) %>
    </div>
  </form>
</section>
