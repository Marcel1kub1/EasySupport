<section class="module-settings">
  <header class="page-heading">
    <div>
      <p class="section-kicker">Anti-Nuke</p>
      <h1>Anti-Nuke settings</h1>
      <p>Configure raid protection, anti-spam, anti-invite, and anti-link rules.</p>
    </div>
    <a href="/dashboard/<%= guildId %>" class="button button--quiet">← Back to guild</a>
  </header>

  <form method="post" action="/admin/modules/<%= guildId %>/anti_nuke" class="settings-form">
    <div class="settings-grid">
      <% 
      const fields = [
        { key: 'anti_raid_enabled', label: 'Anti-Raid', type: 'toggle', desc: 'Protect against mass channel/role creation' },
        { key: 'anti_raid_threshold', label: 'Raid Threshold', type: 'number', desc: 'Max actions per minute before raid detected' },
        { key: 'anti_raid_action', label: 'Raid Action', type: 'select', desc: 'Action to take on raid detection', options: ['none','kick','ban'] },
        { key: 'anti_spam_enabled', label: 'Anti-Spam', type: 'toggle', desc: 'Detect and block message spam' },
        { key: 'anti_spam_threshold', label: 'Spam Threshold', type: 'number', desc: 'Max messages per time window' },
        { key: 'anti_invite_enabled', label: 'Anti-Invite', type: 'toggle', desc: 'Block Discord server invites' },
        { key: 'anti_link_enabled', label: 'Anti-Link', type: 'toggle', desc: 'Block unwanted links' },
        { key: 'nuke_protection_enabled', label: 'Nuke Protection', type: 'toggle', desc: 'Protect against server nuking' },
        { key: 'whitelist_roles', label: 'Whitelisted Roles', type: 'role-list', desc: 'Roles exempt from anti-nuke protections' },
        { key: 'whitelist_users', label: 'Whitelisted Users', type: 'text', desc: 'Comma-separated user IDs exempt from anti-nuke' },
      ];
      fields.forEach((s) => { %>
        <div class="setting-field">
          <label class="setting-label" for="<%= s.key %>"><%= s.label %></label>
          <p class="setting-desc"><%= s.desc %></p>
          <% if (s.type === 'toggle') { %>
            <div class="toggle">
              <input type="checkbox" id="<%= s.key %>" name="<%= s.key %>" value="true" <%= settings[s.key] === 'true' || settings[s.key] === true ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </div>
          <% } else if (s.type === 'number') { %>
            <div class="input-group">
              <input type="number" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>" min="0">
            </div>
          <% } else if (s.type === 'select') { %>
            <select id="<%= s.key %>" name="<%= s.key %>">
              <% s.options.forEach((opt) => { %>
                <option value="<%= opt %>" <%= settings[s.key] === opt ? 'selected' : '' %>> <%= opt %></option>
              <% }) %>
            </select>
          <%           } else if (s.type === 'role-list') { %>
            <input type="text" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>" data-role-list-value>
            <div class="role-list-widget" data-role-multiselect hidden>
              <div class="role-list-widget__selected" data-role-chips aria-live="polite"></div>
              <label class="sr-only" for="<%= s.key %>-search">Search server roles</label>
              <input id="<%= s.key %>-search" type="search" placeholder="Search server roles" autocomplete="off" data-role-search>
              <div class="role-list-widget__options" role="listbox" aria-multiselectable="true" aria-label="Server roles" data-role-options>
                <% const selectedRoleIds = String(settings[s.key] || '').split(',').map((id) => id.trim()).filter(Boolean); %>
                <% roles.forEach((role) => { %>
                  <div class="role-list-widget__option" role="option" tabindex="-1" aria-selected="<%= selectedRoleIds.includes(role.id) %>" data-role-option data-role-id="<%= role.id %>" data-role-name="<%= role.name %>"><%= role.name %></div>
                <% }) %>
                <% selectedRoleIds.filter((id) => !roles.some((role) => role.id === id)).forEach((id) => { %>
                  <div class="role-list-widget__option" role="option" tabindex="-1" aria-selected="true" data-role-option data-role-id="<%= id %>" data-role-name="Unavailable role"><span>Unavailable role</span><code><%= id %></code></div>
                <% }) %>
              </div>
            </div>
            <span class="field-hint">Choose one or more roles. Saved role IDs that are no longer in the guild are preserved until removed.</span>
          <% } else { %>
            <input type="text" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>">
            <span class="field-hint">Comma-separated IDs</span>
          <% } %>
        </div>
      <% }) %>
    </div>
    <div class="form-actions">
      <button type="submit" class="button button--primary">Save anti-nuke settings</button>
    </div>
  </form>
</section>
