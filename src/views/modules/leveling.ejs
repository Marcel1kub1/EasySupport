<section class="module-settings">
  <header class="page-heading">
    <div>
      <p class="section-kicker">Leveling</p>
      <h1>Leveling settings</h1>
      <p>Configure XP tracking, level rewards, and leaderboards.</p>
    </div>
    <a href="/dashboard/<%= guildId %>" class="button button--quiet">← Back to guild</a>
  </header>

  <form method="post" action="/admin/modules/<%= guildId %>/leveling" class="settings-form">
    <div class="settings-grid">
      <% 
      const fields = [
        { key: 'leveling_enabled', label: 'Leveling Enabled', type: 'toggle', desc: 'Award XP for messages in this server' },
        { key: 'xp_per_message', label: 'XP Per Message', type: 'number', desc: 'XP awarded per message' },
        { key: 'xp_cooldown', label: 'XP Cooldown', type: 'number', desc: 'Seconds between XP awards', unit: 'sec' },
        { key: 'level_up_channel', label: 'Level Up Channel', type: 'channel', desc: 'Channel where level-up announcements are posted' },
        { key: 'level_up_message', label: 'Level Up Message', type: 'text', desc: 'Custom level-up announcement message' },
        { key: 'role_rewards', label: 'Role Rewards', type: 'text', desc: 'Level:Role ID pairs for automatic rewards' },
        { key: 'leaderboard_channel', label: 'Leaderboard Channel', type: 'channel', desc: 'Channel for leaderboard posts' },
        { key: 'disable_xp_channels', label: 'Disable XP Channels', type: 'text', desc: 'Comma-separated channel IDs where XP is disabled' },
        { key: 'disable_xp_roles', label: 'Disable XP Roles', type: 'role-list', desc: 'Roles that should not receive XP' },
        { key: 'xp_multiplier', label: 'XP Multiplier', type: 'number', desc: 'Multiplier for all XP gains', step: '0.1' },
      ];
      fields.forEach((s) => { %>
        <div class="setting-field">
          <label class="setting-label" for="<%= s.key %>"><%= s.label %></label>
          <p class="setting-desc"><%= s.desc %></p>
          <% if (s.type === 'toggle') { %>
            <div class="toggle">
              <input type="checkbox" id="<%= s.key %>" name="<%= s.key %>" value="true" <%= settings[s.key] === 'true' || settings[s.key] === true ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </div>
          <% } else if (s.type === 'number') { %>
            <div class="input-group">
              <input type="number" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>" min="0" <% if(s.step) { %>step="<%= s.step %>"<% } %>>
              <span class="input-suffix"><%= s.unit || '' %></span>
            </div>
          <% } else if (s.type === 'channel') { %>
            <select id="<%= s.key %>" name="<%= s.key %>">
              <option value="">Select a channel</option>
              <% channels.forEach((channel) => { %>
                <option value="<%= channel.id %>" <%= settings[s.key] === channel.id ? 'selected' : '' %>>#<%= channel.name %></option>
              <% }) %>
              <% if (settings[s.key] && !channels.some((channel) => channel.id === settings[s.key])) { %>
                <option value="<%= settings[s.key] %>" selected>Saved channel is unavailable</option>
              <% } %>
            </select>
          <%           } else if (s.type === 'role-list') { %>
            <input type="text" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>" data-role-list-value>
            <div class="role-list-widget" data-role-multiselect hidden>
              <div class="role-list-widget__selected" data-role-chips aria-live="polite"></div>
              <label class="sr-only" for="<%= s.key %>-search">Search server roles</label>
              <input id="<%= s.key %>-search" type="search" placeholder="Search server roles" autocomplete="off" data-role-search>
              <div class="role-list-widget__options" role="listbox" aria-multiselectable="true" aria-label="Server roles" data-role-options>
                <% const selectedRoleIds = String(settings[s.key] || '').split(',').map((id) => id.trim()).filter(Boolean); %>
                <% roles.forEach((role) => { %>
                  <div class="role-list-widget__option" role="option" tabindex="-1" aria-selected="<%= selectedRoleIds.includes(role.id) %>" data-role-option data-role-id="<%= role.id %>" data-role-name="<%= role.name %>"><%= role.name %></div>
                <% }) %>
                <% selectedRoleIds.filter((id) => !roles.some((role) => role.id === id)).forEach((id) => { %>
                  <div class="role-list-widget__option" role="option" tabindex="-1" aria-selected="true" data-role-option data-role-id="<%= id %>" data-role-name="Unavailable role"><span>Unavailable role</span><code><%= id %></code></div>
                <% }) %>
              </div>
            </div>
            <span class="field-hint">Choose one or more roles. Saved role IDs that are no longer in the guild are preserved until removed.</span>
          <% } else { %>
            <input type="text" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>">
            <span class="field-hint">Comma-separated values</span>
          <% } %>
        </div>
      <% }) %>
    </div>
    <div class="form-actions">
      <%- include('../partials/save-button', { settingName: 'leveling' }) %>
    </div>
  </form>
</section>
