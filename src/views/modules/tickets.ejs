<section class="module-settings">
  <header class="page-heading">
    <div>
      <p class="section-kicker">Tickets</p>
      <h1>Ticket settings</h1>
      <p>Configure ticket panels, categories, staff roles, and transcript options.</p>
    </div>
    <a href="/dashboard/<%= guildId %>" class="button button--quiet">← Back to guild</a>
  </header>

  <form method="post" action="/admin/modules/<%= guildId %>/tickets" class="settings-form">
    <div class="settings-grid">
      <% 
      const fields = [
        { key: 'panel_channel', label: 'Panel Channel', type: 'channel', desc: 'Channel where the ticket panel is posted' },
        { key: 'ticket_category', label: 'Ticket Category', type: 'category', desc: 'Category where ticket channels are created' },
        { key: 'log_channel', label: 'Log Channel', type: 'channel', desc: 'Channel for ticket action logs' },
        { key: 'transcript_channel', label: 'Transcript Channel', type: 'channel', desc: 'Channel where closed ticket transcripts are posted' },
        { key: 'welcome_dm', label: 'Welcome DM', type: 'toggle', desc: 'Send a welcome DM when a ticket opens' },
        { key: 'close_timeout', label: 'Close Timeout', type: 'number', desc: 'Minutes of inactivity before auto-close', unit: 'min' },
        { key: 'max_tickets_per_user', label: 'Max Tickets Per User', type: 'number', desc: 'Maximum concurrent tickets per user' },
        { key: 'ticket_open_role', label: 'Ticket Access Role', type: 'role', desc: 'Members with this role can open tickets even if they are on the ticket blacklist' },
        { key: 'staff_role', label: 'Staff Role', type: 'role', desc: 'Role with access to all tickets' },
        { key: 'support_role', label: 'Support Role', type: 'role', desc: 'Role that can be assigned to tickets' },
        { key: 'ticket_prefix', label: 'Ticket Prefix', type: 'text', desc: 'Prefix for ticket channel names' },
      ];
      fields.forEach((s) => { %>
        <div class="setting-field">
          <label class="setting-label" for="<%= s.key %>"><%= s.label %></label>
          <p class="setting-desc"><%= s.desc %></p>
          <% if (s.type === 'toggle') { %>
            <div class="toggle">
              <input type="checkbox" id="<%= s.key %>" name="<%= s.key %>" value="true" <%= settings[s.key] === 'true' || settings[s.key] === true ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </div>
          <% } else if (s.type === 'number') { %>
            <div class="input-group">
              <input type="number" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>" min="0">
              <span class="input-suffix"><%= s.unit %></span>
            </div>
          <% } else if (s.type === 'role') { %>
            <select id="<%= s.key %>" name="<%= s.key %>" data-role-picker="single">
              <option value="">Select a role</option>
              <% roles.forEach((role) => { %>
                <option value="<%= role.id %>" <%= settings[s.key] === role.id ? 'selected' : '' %>><%= role.name %></option>
              <% }) %>
              <% if (settings[s.key] && !roles.some((role) => role.id === settings[s.key])) { %>
                <option value="<%= settings[s.key] %>" selected>Saved role is unavailable</option>
              <% } %>
            </select>
          <% } else if (s.type === 'channel' || s.type === 'category') { %>
            <% const choices = s.type === 'category' ? categories : channels; %>
            <select id="<%= s.key %>" name="<%= s.key %>">
              <option value="">Select a <%= s.type %></option>
              <% choices.forEach((choice) => { %>
                <option value="<%= choice.id %>" <%= settings[s.key] === choice.id ? 'selected' : '' %>><%= s.type === 'channel' ? `#${choice.name}` : choice.name %></option>
              <% }) %>
              <% if (settings[s.key] && !choices.some((choice) => choice.id === settings[s.key])) { %>
                <option value="<%= settings[s.key] %>" selected>Saved <%= s.type %> is unavailable</option>
              <% } %>
            </select>
          <% } else { %>
            <input type="text" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>">
          <% } %>
        </div>
      <% }) %>
    </div>
    <div class="form-actions">
      <%- include('../partials/save-button', { settingName: 'ticket' }) %>
    </div>
  </form>
</section>
