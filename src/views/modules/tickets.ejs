<section class="module-settings">
  <header class="page-heading">
    <div>
      <p class="section-kicker">Tickets</p>
      <h1>Ticket settings</h1>
      <p>Configure ticket panels, categories, staff roles, and transcript options.</p>
    </div>
    <a href="/dashboard" class="button button--quiet">← Back to dashboard</a>
  </header>

  <form method="post" action="/admin/modules/<%= guildId %>/tickets" class="settings-form">
    <div class="settings-grid">
      <% 
      const settings = [
        { key: 'panel_channel', label: 'Panel Channel', type: 'channel', desc: 'Channel where the ticket panel is posted' },
        { key: 'ticket_category', label: 'Ticket Category', type: 'category', desc: 'Category where ticket channels are created' },
        { key: 'log_channel', label: 'Log Channel', type: 'channel', desc: 'Channel for ticket action logs' },
        { key: 'transcript_channel', label: 'Transcript Channel', type: 'channel', desc: 'Channel where closed ticket transcripts are posted' },
        { key: 'welcome_dm', label: 'Welcome DM', type: 'toggle', desc: 'Send a welcome DM when a ticket opens' },
        { key: 'close_timeout', label: 'Close Timeout', type: 'number', desc: 'Minutes of inactivity before auto-close', unit: 'min' },
        { key: 'max_tickets_per_user', label: 'Max Tickets Per User', type: 'number', desc: 'Maximum concurrent tickets per user' },
        { key: 'staff_role', label: 'Staff Role', type: 'role', desc: 'Role with access to all tickets' },
        { key: 'support_role', label: 'Support Role', type: 'role', desc: 'Role that can be assigned to tickets' },
        { key: 'ticket_prefix', label: 'Ticket Prefix', type: 'text', desc: 'Prefix for ticket channel names' },
      ];
      settings.forEach((s) => { %>
        <div class="setting-field">
          <label class="setting-label"><%= s.label %></label>
          <p class="setting-desc"><%= s.desc %></p>
          <% if (s.type === 'toggle') { %>
            <div class="toggle">
              <input type="checkbox" id="<%= s.key %>" name="<%= s.key %>" value="true" <%= settings[s.key] === 'true' || settings[s.key] === true ? 'checked' : '' %>>
              <span class="toggle-slider"></span>
            </div>
          <% } else if (s.type === 'number') { %>
            <div class="input-group">
              <input type="number" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>" min="0">
              <span class="input-suffix"><%= s.unit %></span>
            </div>
          <% } else if (s.type === 'channel' || s.type === 'category' || s.type === 'role') { %>
            <input type="text" id="<%= s.key %>" name="<%= s.key %>" placeholder="ID or mention" value="<%= settings[s.key] || '' %>">
            <span class="field-hint">Enter the <%= s.type %> ID</span>
          <% } else { %>
            <input type="text" id="<%= s.key %>" name="<%= s.key %>" value="<%= settings[s.key] || '' %>">
          <% } %>
        </div>
      <% }) %>
    </div>
    <div class="form-actions">
      <button type="submit" class="button button--primary">Save ticket settings</button>
    </div>
  </form>
</section>

<style>
.module-settings {
  max-width: 900px;
  margin: 0 auto;
  padding: 24px;
}
.page-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32px;
}
.page-heading > div {
  flex: 1;
}
.section-kicker {
  color: var(--muted);
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 8px;
}
.page-heading h1 {
  font-size: 28px;
  color: var(--ink);
  margin-bottom: 4px;
  letter-spacing: -0.04em;
}
.page-heading p {
  color: var(--muted);
  font-size: 15px;
}
.settings-form {
  background: var(--surface);
  border: 1px solid var(--line);
  border-radius: var(--radius);
  padding: 32px;
}
.settings-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
  gap: 24px;
}
.setting-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
}
.setting-label {
  font-size: 14px;
  font-weight: 700;
  color: var(--ink);
}
.setting-desc {
  font-size: 12px;
  color: var(--muted);
  margin: 0;
}
.toggle {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
  font-size: 14px;
  color: var(--ink);
}
.toggle input {
  opacity: 0;
  width: 0;
  height: 0;
  pointer-events: none;
}
.toggle-slider {
  width: 44px;
  height: 24px;
  border-radius: 12px;
  background: var(--surface-raised);
  border: 2px solid var(--line);
  transition: all 160ms ease;
}
.toggle input:checked + .toggle-slider {
  background: var(--accent);
  border-color: var(--accent);
}
.input-group {
  display: flex;
  align-items: center;
  gap: 8px;
}
.input-group input {
  flex: 1;
}
.input-suffix {
  font-size: 13px;
  color: var(--muted);
  font-weight: 600;
}
input[type="text"], input[type="number"] {
  width: 100%;
  padding: 10px 14px;
  background: var(--surface-quiet);
  border: 1px solid var(--line);
  border-radius: 8px;
  color: var(--ink);
  font-size: 14px;
}
input[type="text"]:focus, input[type="number"]:focus {
  outline: none;
  border-color: var(--accent);
}
.field-hint {
  font-size: 11px;
  color: var(--muted);
  margin-top: 4px;
}
.form-actions {
  margin-top: 32px;
  display: flex;
  justify-content: flex-end;
}
@media (max-width: 640px) {
  .module-settings {
    padding: 16px;
  }
  .settings-form {
    padding: 20px;
  }
  .settings-grid {
    grid-template-columns: 1fr;
  }
  .page-heading {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
}
</style>