<section class="home">
  <div class="marquee-wrap">
    <div class="marquee-track">
      <span>EasySupport</span><span class="sep">·</span><span>Discord ticketing</span><span class="sep">·</span><span>Self-hosted</span><span class="sep">·</span><span>MySQL storage</span><span class="sep">·</span><span>One panel</span><span class="sep">·</span><span>EasySupport</span><span class="sep">·</span><span>Discord ticketing</span><span class="sep">·</span><span>Self-hosted</span><span class="sep">·</span><span>MySQL storage</span><span class="sep">·</span><span>One panel</span>
    </div>
  </div>

  <div class="canvas">
    <div class="blob blob--1"></div>
    <div class="blob blob--2"></div>
    <div class="blob blob--3"></div>
  </div>

  <div class="hero reveal">
    <h1 class="glitch reveal" data-glitch="Ticketing, rebuilt.">Ticketing, rebuilt.</h1>
    <p class="lead reveal">Private support tickets, staff workflows, transcripts and ratings — driven by one config file. Self-hosted on your server alongside the bot, sharing a single database.</p>
    <div class="hero-actions reveal">
      <a class="btn btn-primary" href="<%= repoUrl %>" target="_blank" rel="noopener">View on GitHub</a>
      <a class="btn btn-outline" href="/status">System status</a>
    </div>
  </div>

  <section class="features reveal">
    <div class="section-title reveal">What it does</div>
    <div class="feature-grid">
      <div class="feature card reveal">
        <div class="feature-dot"></div>
        <h3>One-click tickets</h3>
        <p>/panel posts a button per category; members get a private channel instantly with intake questions.</p>
      </div>
      <div class="feature card reveal">
        <div class="feature-dot"></div>
        <h3>Staff workflow</h3>
        <p>Claim, pending, escalate, close — every status is a button on the ticket panel. Changes are atomic.</p>
      </div>
      <div class="feature card reveal">
        <div class="feature-dot"></div>
        <h3>Transcripts &amp; ratings</h3>
        <p>TXT + HTML transcripts on closure plus a 1–5 star rating DM to the member.</p>
      </div>
      <div class="feature card reveal">
        <div class="feature-dot"></div>
        <h3>MySQL storage</h3>
        <p>Bot and website share a single MySQL database on one host — no separate process needed.</p>
      </div>
    </div>
  </section>
</section>

<style>
  .home { position: relative; overflow: hidden; }
  .marquee-wrap { width: 100%; overflow: hidden; border-bottom: 1px solid var(--border); background: var(--bg); }
  .marquee-track { display: inline-block; white-space: nowrap; animation: marquee 22s linear infinite; padding: 10px 0; }
  .marquee-track span { display: inline-block; margin: 0 20px; color: var(--muted); font-size: 0.85rem; font-weight: 700; letter-spacing: 0.08em; }
  .marquee-track .sep { color: var(--border); font-weight: 400; }
  @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  .canvas { position: absolute; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(44px);
    opacity: 0.35;
    animation: drift 14s ease-in-out infinite alternate;
  }
  .blob--1 { top: 8%; left: 6%; width: 380px; height: 380px; background: var(--accent); animation-delay: 0s; }
  .blob--2 { bottom: 12%; right: 10%; width: 460px; height: 460px; background: var(--accent-2); animation-delay: -5s; }
  .blob--3 { top: 40%; left: 60%; width: 340px; height: 340px; background: #22c55e; animation-delay: -9s; }
  @keyframes drift { 0% { transform: translate(0, 0) scale(1); } 100% { transform: translate(45px, -70px) scale(1.18); } }
  .hero { position: relative; z-index: 1; padding: 100px 0 60px; text-align: left; max-width: 720px; }
  .hero h1 { font-size: 4.6rem; font-weight: 800; letter-spacing: -0.04em; line-height: 1.02; margin: 0 0 20px; color: var(--text); }
  .glitch { position: relative; display: inline-block; }
  .glitch::before, .glitch::after { content: attr(data-glitch); position: absolute; inset: 0; left: 0; width: 100%; height: 100%; }
  .glitch::before { left: 2px; text-shadow: -1px 0 var(--accent-2); clip: rect(30px, 9999px, 90px, 0); animation: glitch-1 3s infinite linear alternate-reverse; }
  .glitch::after { left: -2px; text-shadow: -1px 0 var(--accent); clip: rect(80px, 9999px, 135px, 0); animation: glitch-2 2.5s infinite linear alternate-reverse; }
  @keyframes glitch-1 { 0% { clip: rect(60px, 9999px, 75px, 0); } 20% { clip: rect(340px, 9999px, 8px, 0); } 40% { clip: rect(58px, 9999px, 86px, 0); } 60% { clip: rect(12px, 9999px, 55px, 0); } 80% { clip: rect(210px, 9999px, 14px, 0); } 100% { clip: rect(16px, 9999px, 88px, 0); } }
  @keyframes glitch-2 { 0% { clip: rect(12px, 9999px, 82px, 0); } 30% { clip: rect(92px, 9999px, 4px, 0); } 50% { clip: rect(14px, 9999px, 68px, 0); } 70% { clip: rect(10px, 9999px, 88px, 0); } 100% { clip: rect(72px, 9999px, 18px, 0); } }
  .hero .lead { color: var(--muted); font-size: 1.05rem; max-width: 560px; margin-bottom: 32px; line-height: 1.75; font-weight: 400; }
  .hero-actions { display: flex; gap: 12px; }
  .features { position: relative; z-index: 1; padding: 60px 0 100px; border-top: 1px solid var(--border); }
  .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .feature { position: relative; padding-left: 30px; padding: 20px; }
  .feature-dot { position: absolute; left: 0; top: 8px; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px rgba(88, 101, 242, 0.18); }
  .feature h3 { font-size: 0.95rem; font-weight: 700; letter-spacing: -0.01em; color: var(--text); margin-bottom: 8px; }
  .feature p { color: var(--muted); font-size: 0.9rem; line-height: 1.65; margin: 0; }
  @media (max-width: 640px) {
    .hero h1 { font-size: 2.8rem; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn { justify-content: center; }
    .feature-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  })();
</script>
