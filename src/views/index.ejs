<section class="home">
  <div class="marquee-wrap">
    <div class="marquee">
      <div class="marquee-track">
        <span>EasySupport</span><span class="sep">·</span><span>Discord ticketing</span><span class="sep">·</span><span>Self-hosted</span><span class="sep">·</span><span>MySQL storage</span><span class="sep">·</span><span>One panel</span><span class="sep">·</span><span>EasySupport</span><span class="sep">·</span><span>Discord ticketing</span><span class="sep">·</span><span>Self-hosted</span><span class="sep">·</span><span>MySQL storage</span><span class="sep">·</span><span>One panel</span>
      </div>
    </div>
  </div>

  <div class="canvas">
    <div class="blob blob--1"></div>
    <div class="blob blob--2"></div>
    <div class="blob blob--3"></div>
  </div>

  <div class="hero reveal">
    <h1 class="glitch" data-glitch="Ticketing, rebuilt.">Ticketing, rebuilt.</h1>
    <p class="lead reveal">Private support tickets, staff workflows, transcripts and ratings — driven by one config file. Self-hosted on your server with a public status page.</p>
    <div class="hero-actions reveal">
      <a class="btn btn-primary" href="<%= repoUrl %>" target="_blank" rel="noopener">View on GitHub</a>
      <a class="btn btn-outline" href="/status">System status</a>
    </div>
  </div>

  <section class="features reveal">
    <div class="feature-grid">
      <div class="feature">
        <div class="feature-dot"></div>
        <h3>One-click tickets</h3>
        <p>/panel posts a button per category; members get a private channel instantly with intake questions.</p>
      </div>
      <div class="feature">
        <div class="feature-dot"></div>
        <h3>Staff workflow</h3>
        <p>Claim, pending, escalate, close — every status is a button on the ticket panel. Changes are atomic.</p>
      </div>
      <div class="feature">
        <div class="feature-dot"></div>
        <h3>Transcripts &amp; ratings</h3>
        <p>TXT + HTML transcripts on closure plus a 1–5 star rating DM to the member.</p>
      </div>
      <div class="feature">
        <div class="feature-dot"></div>
        <h3>MySQL storage</h3>
        <p>Bot and website share a single MySQL database on one host — no separate process needed.</p>
      </div>
    </div>
  </section>
</section>

<style>
  :root {
    --accent: #5865f2;
    --accent-2: #ec4899;
    --ink: #000000;
    --panel: #0a0a0a;
    --border: #1a1a1a;
    --text: #f5f5f5;
    --muted: #737373;
    --radius: 10px;
  }

  .home { position: relative; overflow: hidden; }

  /* Marquee */
  .marquee-wrap { width: 100%; overflow: hidden; border-bottom: 1px solid var(--border); background: var(--ink); }
  .marquee { padding: 10px 0; overflow: hidden; }
  .marquee-track { display: inline-block; white-space: nowrap; animation: marquee 20s linear infinite; font-variant-numeric: tabular-nums; }
  .marquee span { display: inline-block; margin: 0 18px; color: var(--muted); font-size: 0.85rem; letter-spacing: 0.05em; font-variant: all-petite-caps; }
  .marquee .sep { color: var(--border); }
  @keyframes marquee { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }

  /* Canvas / blobs */
  .canvas { position: absolute; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.35;
    animation: drift 12s ease-in-out infinite alternate;
  }
  .blob--1 { top: 10%; left: 10%; width: 360px; height: 360px; background: var(--accent); animation-delay: 0s; }
  .blob--2 { bottom: 15%; right: 12%; width: 420px; height: 420px; background: var(--accent-2); animation-delay: -4s; }
  .blob--3 { top: 45%; left: 55%; width: 300px; height: 300px; background: #22c55e; animation-delay: -8s; }
  @keyframes drift { 0% { transform: translate(0, 0) scale(1); } 100% { transform: translate(40px, -60px) scale(1.15); } }

  /* Hero */
  .hero { position: relative; z-index: 1; padding: 110px 0 70px; text-align: left; max-width: 760px; }
  .hero h1 { font-size: 4.2rem; font-weight: 800; letter-spacing: -0.04em; line-height: 1.05; margin: 0 0 18px; color: var(--text); }
  .glitch { position: relative; display: inline-block; }
  .glitch::before, .glitch::after { content: attr(data-glitch); position: absolute; inset: 0; left: 0; width: 100%; height: 100%; }
  .glitch::before { left: 2px; text-shadow: -1px 0 var(--accent-2); clip: rect(28px, 550px, 95px, 0); animation: glitch-1 3s infinite linear alternate-reverse; }
  .glitch::after { left: -2px; text-shadow: -1px 0 var(--accent); clip: rect(85px, 550px, 140px, 0); animation: glitch-2 2.5s infinite linear alternate-reverse; }
  @keyframes glitch-1 { 0% { clip: rect(62px, 9999px, 74px, 0); } 20% { clip: rect(340px, 9999px, 10px, 0); } 40% { clip: rect(60px, 9999px, 88px, 0); } 60% { clip: rect(10px, 9999px, 55px, 0); } 80% { clip: rect(210px, 9999px, 12px, 0); } 100% { clip: rect(14px, 9999px, 90px, 0); } }
  @keyframes glitch-2 { 0% { clip: rect(14px, 9999px, 80px, 0); } 30% { clip: rect(90px, 9999px, 4px, 0); } 50% { clip: rect(10px, 9999px, 70px, 0); } 70% { clip: rect(12px, 9999px, 85px, 0); } 100% { clip: rect(70px, 9999px, 16px, 0); } }
  .hero .lead { color: var(--muted); font-size: 1.05rem; max-width: 560px; margin-bottom: 30px; line-height: 1.7; font-weight: 400; }
  .hero-actions { display: flex; gap: 14px; }
  .btn { display: inline-flex; align-items: center; gap: 8px; border: 1px solid transparent; border-radius: var(--radius); padding: 11px 22px; font-size: 0.95rem; font-weight: 600; cursor: pointer; text-decoration: none; transition: transform 0.15s ease, filter 0.25s ease; }
  .btn:active { transform: translateY(-1px); }
  .btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
  .btn-primary:hover { filter: brightness(1.15); }
  .btn-outline { background: transparent; color: var(--text); border-color: var(--border); }
  .btn-outline:hover { border-color: var(--text); background: rgba(255,255,255,0.04); }

  /* Features */
  .features { position: relative; z-index: 1; padding: 70px 0 110px; border-top: 1px solid var(--border); }
  .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; }
  .feature { position: relative; padding-left: 34px; }
  .feature-dot { position: absolute; left: 0; top: 4px; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px rgba(88, 101, 242, 0.2); }
  .feature h3 { font-size: 1rem; font-weight: 700; letter-spacing: -0.01em; color: var(--text); margin-bottom: 8px; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.12em; }
  .feature p { color: var(--muted); font-size: 0.9rem; line-height: 1.65; margin: 0; }

  /* Scroll reveals */
  .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s cubic-bezier(0.2, 1, 0.3, 1), transform 0.7s cubic-bezier(0.2, 1, 0.3, 1); will-change: opacity, transform; }
  .reveal.visible { opacity: 1; transform: none; }
  .reveal:nth-child(2) { transition-delay: 0.1s; }
  .reveal:nth-child(3) { transition-delay: 0.2s; }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
    .blob { animation: none; }
    .reveal { opacity: 1; transform: none; transition: none; }
    .glitch::before, .glitch::after { display: none; }
  }
  @media (max-width: 640px) {
    .hero h1 { font-size: 2.6rem; }
    .hero-actions { flex-direction: column; align-items: stretch; }
    .hero-actions .btn { justify-content: center; }
    .feature-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  (function () {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  })();
</script>
