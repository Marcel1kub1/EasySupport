<section class="landing">
  <div class="landing-hero">
    <div class="landing-hero__copy" data-reveal>
      <p class="eyebrow">Self-hosted Discord support</p>
      <h1>Make support feel <span>under control.</span></h1>
      <p class="landing-hero__description">Bring private tickets, staff workflows, and community tools into one clear place, configured for your guild.</p>
      <div class="landing-actions">
        <a class="button button--primary" href="<%= signedIn ? '/dashboard' : '/login' %>"><%= signedIn ? 'Open guild dashboard' : 'Connect Discord' %><span aria-hidden="true">↗</span></a>
        <a class="text-link" href="<%= repoUrl %>" target="_blank" rel="noopener noreferrer">Explore the source <span aria-hidden="true">↗</span></a>
      </div>
      <p class="landing-hero__note">Open source · Runs alongside your Discord bot</p>
    </div>
    <figure class="hero-product" data-reveal data-product-visual>
      <div class="hero-product__frame">
        <img src="/assets/panel.png" alt="EasySupport ticket panel in Discord, showing categories members can choose from">
      </div>
      <figcaption><span>Support starts with a clear next step.</span><span>EasySupport · Ticket panel</span></figcaption>
    </figure>
  </div>

  <div class="module-marquee" aria-label="Available guild modules">
    <div class="module-marquee__track" data-module-marquee>
      <div class="module-marquee__group">
        <% modules.forEach((module) => { %><span><i aria-hidden="true"></i><%= module.title %></span><% }) %>
      </div>
      <div class="module-marquee__group" aria-hidden="true">
        <% modules.forEach((module) => { %><span><i aria-hidden="true"></i><%= module.title %></span><% }) %>
      </div>
    </div>
  </div>

  <section class="product-story" aria-labelledby="story-heading">
    <div class="product-story__copy" data-reveal>
      <p class="eyebrow">Designed around real conversations</p>
      <h2 id="story-heading">From the first request to the final handoff.</h2>
      <p>Give every request a private place. Keep staff actions and intake context together, then leave a useful record when the work is done.</p>
      <a class="text-link" href="<%= signedIn ? '/dashboard' : '/login' %>">Configure your guild <span aria-hidden="true">↗</span></a>
    </div>
    <figure class="story-product" data-story-stage data-product-visual>
      <div class="story-product__stack">
        <div class="story-product__card story-product__card--back" data-story-card="back">
          <img src="/assets/panel.png" alt="EasySupport ticket panel with support categories members can choose from">
        </div>
        <div class="story-product__card story-product__card--front" data-story-card="front" data-reveal>
          <img src="/assets/ticket.png" alt="An EasySupport ticket showing status controls, intake answers, and the conversation">
        </div>
      </div>
      <figcaption><span>Every request has context.</span><span>Staff controls, intake, and transcript in one flow.</span></figcaption>
    </figure>
  </section>

  <section class="module-accordion-section" aria-labelledby="capabilities-heading">
    <header class="module-accordion-section__heading" data-reveal>
      <div>
        <p class="eyebrow">One connected toolkit</p>
        <h2 id="capabilities-heading">The tools your guild needs.</h2>
      </div>
      <p>Enable and configure each module from a single guild dashboard.</p>
    </header>
    <div class="module-accordion">
      <% modules.forEach((module) => { %>
        <details class="module-accordion__item" data-reveal>
          <summary>
            <span class="module-accordion__title"><%= module.title %></span>
            <span class="module-accordion__description"><%= module.desc %></span>
            <span class="module-accordion__toggle" aria-hidden="true"></span>
          </summary>
          <div class="module-accordion__content">
            <p><%= module.desc %> Configure it for your guild, select its roles or channels, and save your settings in the dashboard.</p>
            <a class="text-link" href="<%= signedIn ? '/dashboard' : '/login' %>">Open the guild dashboard <span aria-hidden="true">↗</span></a>
          </div>
        </details>
      <% }) %>
    </div>
  </section>

  <section class="landing-close" data-reveal>
    <div>
      <p class="eyebrow">Your guild, your setup</p>
      <h2>Support tools, on your terms.</h2>
      <p>Self-host EasySupport and shape the workflows around your community.</p>
    </div>
    <a class="button button--light" href="<%= signedIn ? '/dashboard' : '/login' %>">Start with your guild <span aria-hidden="true">↗</span></a>
  </section>
</section>
