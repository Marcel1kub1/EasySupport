<section class="admin">
  <div class="admin-header">
    <h1 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; margin: 0;">Admin</h1>
    <a href="/admin/logout" class="btn btn-danger btn-sm">Logout</a>
  </div>

  <section class="admin-card card" style="margin-bottom: 32px;">
    <div class="section-title">System status</div>
    <div class="status-row" style="display: flex; gap: 10px; align-items: center; margin-bottom: 14px; flex-wrap: wrap;">
      <span class="badge badge--<%= (status?.status_text ?? '').toLowerCase().includes('outage') ? 'outage' : (status?.status_text ?? '').toLowerCase().includes('degrad') ? 'degraded' : 'operational' %>">
        <%= status?.status_text ?? 'All systems operational' %>
      </span>
    </div>
    <form method="post" action="/admin/status" class="status-form">
      <input name="status_text" placeholder="New status message" required style="background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 10px 14px; color: var(--text); font-size: 0.95rem;">
      <button class="btn btn-primary btn-sm">Update status</button>
    </form>
  </section>

  <section class="admin-card card" style="margin-bottom: 32px;">
    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px;">
      <div class="section-title">Post announcement</div>
      <span class="badge" style="font-size: 0.75rem; opacity: 0.7;">Hardcoded — one click</span>
    </div>
    <div class="announce-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px;">
      <% hardcoded.forEach((a) => { %>
        <form method="post" action="/admin/announce" class="announce-btn card" style="display: flex; align-items: center; gap: 12px; padding: 14px 16px; cursor: pointer; border: 1px solid var(--border); transition: transform 0.15s ease, border-color 0.2s;">
          <input type="hidden" name="key" value="<%= a.key %>">
          <div class="announce-icon" style="width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0; <% if (a.type === 'info') { %>background: rgba(88, 101, 242, 0.15); color: var(--accent);<% } else if (a.type === 'warn') { %>background: rgba(245, 158, 11, 0.15); color: var(--warn);<% } else if (a.type === 'feature') { %>background: rgba(122, 105, 249, 0.15); color: #7A69F9;<% } else { %>background: rgba(239, 68, 68, 0.15); color: var(--err);<% } %>">
            <% if (a.type === 'info') { %>🟢<% } else if (a.type === 'warn') { %>⚠️<% } else if (a.type === 'feature') { %>✨<% } else { %>🔴<% } %>
          </div>
          <div>
            <div style="font-weight: 800; color: var(--text); font-size: 0.95rem; margin-bottom: 2px;"><%= a.title %></div>
            <div style="color: var(--muted); font-size: 0.82rem; white-space: pre-wrap;"><%= a.content %></div>
          </div>
          <button class="btn btn-primary btn-sm" style="margin-left: auto;">Post</button>
        </form>
      <% }) %>
    </div>
  </section>

  <% if (announcements && announcements.length) { %>
    <section class="admin-card card">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
        <div class="section-title">Recent announcements</div>
        <span class="badge" style="font-size: 0.75rem; opacity: 0.7;">Showing latest 10</span>
      </div>
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <% announcements.forEach((a) => { %>
          <div class="announce-list card" style="padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; gap: 12px;">
            <div>
              <div style="font-weight: 700; color: var(--text); font-size: 0.9rem;"><%= a.title %></div>
              <div style="color: var(--muted); font-size: 0.82rem; white-space: pre-wrap;"><%= a.content %></div>
            </div>
            <div style="color: var(--muted); font-size: 0.75rem; text-align: right;">
              <%= a.created_by ?? 'admin' %><br>
              <span style="font-size: 0.7rem; opacity: 0.7;"><%= new Date(a.created_at).toLocaleString() %></span>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  <% } %>

  <style>
    .admin { max-width: 760px; }
    .admin-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 30px; }
    .status-row { margin-bottom: 14px; }
    .announce-btn:hover { transform: translateY(-2px); border-color: var(--accent); background: rgba(88, 101, 242, 0.05); }
    .announce-list { border: 1px solid var(--border); background: var(--panel); }
    .section-title { font-size: 0.85rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 14px; }
    .badge--operational { background: rgba(16, 185, 129, 0.12); color: var(--ok); border: 1px solid rgba(16, 185, 129, 0.25); }
    .badge--degraded { background: rgba(245, 158, 11, 0.12); color: var(--warn); border: 1px solid rgba(245, 158, 11, 0.25); }
    .badge--outage { background: rgba(239, 68, 68, 0.12); color: var(--err); border: 1px solid rgba(239, 68, 68, 0.25); }
    .badge--maintenance { background: rgba(100, 116, 139, 0.12); color: #94a3b8; border: 1px solid rgba(100, 116, 139, 0.25); }
    @media (max-width: 640px) {
      .announce-btn { flex-direction: column; align-items: stretch; gap: 10px; }
      .announce-btn .btn { width: 100%; margin-left: 0; margin-top: 8px; }
    }
  </style>
</section>
