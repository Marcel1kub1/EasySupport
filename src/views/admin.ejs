<%
  var statusTone = 'operational';
  var currentStatus = status?.status_text ?? 'All systems operational';
  var statusLower = currentStatus.toLowerCase();
  if (statusLower.includes('outage')) {
    statusTone = 'outage';
  } else if (statusLower.includes('degrad')) {
    statusTone = 'degraded';
  } else if (statusLower.includes('maintenance')) {
    statusTone = 'maintenance';
  }
%>
<section class="admin-page">
  <header class="page-heading admin-heading">
    <div>
      <p class="section-kicker">EasySupport administration</p>
      <h1>Manage updates</h1>
    </div>
    <a class="button button--quiet" href="/status">View public status <span aria-hidden="true">↗</span></a>
  </header>

  <% if (statusUpdated) { %>
    <aside class="status-notice" role="status" aria-live="polite">
      <button class="status-notice__dismiss" type="button" data-dismiss-notice aria-label="Dismiss status update notification">×</button>
      <div class="status-notice__header">
        <span class="status-notice__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <path d="m5 12 4.5 4.5L19 7" />
          </svg>
        </span>
        <div>
          <h2>Status updated</h2>
          <p><%= currentStatus %></p>
        </div>
      </div>
      <div class="status-notice__actions">
        <a href="#recent-announcements-heading">History</a>
        <a href="/status">View live status</a>
      </div>
    </aside>
  <% } %>

  <section class="admin-section" aria-labelledby="system-status-heading">
    <div class="section-heading">
      <h2 id="system-status-heading">Current system status</h2>
      <p>This message appears on the public status page.</p>
    </div>
    <div class="current-status">
      <span class="status-light status-light--<%= statusTone %>" aria-hidden="true"></span>
      <p><%= currentStatus %></p>
    </div>
    <form method="post" action="/admin/status" class="status-form">
      <label class="visually-hidden" for="status-text">New status message</label>
      <input id="status-text" name="status_text" maxlength="255" placeholder="Enter a status message" required>
      <button class="button button--primary" type="submit">Update status</button>
    </form>
  </section>

  <section class="admin-section" aria-labelledby="quick-updates-heading">
    <div class="section-heading">
      <h2 id="quick-updates-heading">Quick announcements</h2>
      <p>Publish a prepared update to the public status page.</p>
    </div>
    <div class="quick-update-list">
      <% hardcoded.forEach((announcement) => { %>
        <form method="post" action="/admin/announce" class="quick-update">
          <input type="hidden" name="key" value="<%= announcement.key %>">
          <div>
            <h3><%= announcement.title %></h3>
            <p><%= announcement.content %></p>
          </div>
          <button class="button button--quiet" type="submit">Publish</button>
        </form>
      <% }) %>
    </div>
  </section>

  <section class="admin-section" aria-labelledby="custom-update-heading">
    <div class="section-heading">
      <h2 id="custom-update-heading">Write an announcement</h2>
      <p>Share a short update with everyone using the public status page.</p>
    </div>
    <form method="post" action="/admin/announce" class="custom-announce-form">
      <div class="form-group">
        <label for="announcement-title">Title</label>
        <input id="announcement-title" name="title" maxlength="255" placeholder="A short, clear headline" required>
      </div>
      <div class="form-group">
        <label for="announcement-content">Message</label>
        <textarea id="announcement-content" name="content" rows="5" placeholder="What should visitors know?" required></textarea>
      </div>
      <button class="button button--primary" type="submit">Publish announcement</button>
    </form>
  </section>

  <% if (announcements && announcements.length) { %>
    <section class="admin-section" aria-labelledby="recent-announcements-heading">
      <div class="section-heading">
        <h2 id="recent-announcements-heading">Recent announcements</h2>
        <p>Latest updates on the public status page.</p>
      </div>
      <div class="announcement-list">
        <% announcements.forEach((announcement) => { %>
          <article class="announcement announcement--admin">
            <div>
              <h3><%= announcement.title %></h3>
              <p><%= announcement.content %></p>
              <div class="announcement-meta">
                <span>Posted by <%= announcement.created_by ?? 'admin' %></span>
                <time datetime="<%= new Date(announcement.created_at).toISOString() %>"><%= new Date(announcement.created_at).toLocaleString() %></time>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    </section>
  <% } %>
</section>
