<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #050708;
      --panel: #0a0c0f;
      --border: #12181f;
      --text: #f8fafc;
      --muted: #94a3b8;
      --accent: #5865f2;
      --accent-hover: #4752c4;
      --ok: #10b981;
      --warn: #f59e0b;
      --err: #ef4444;
      --radius: 10px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--bg);
      color: var(--text);
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.6;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { color: var(--accent-hover); text-decoration: underline; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .container { max-width: 1000px; margin: 0 auto; padding: 0 20px; }
    header { position: sticky; top: 0; z-index: 50; }
    .navbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
      padding: 0 20px;
      background: rgba(5, 7, 8, 0.7);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 800;
      font-size: 1.15rem;
      letter-spacing: -0.02em;
      color: var(--text);
    }
    .brand .mark {
      width: 28px;
      height: 28px;
      background: var(--accent);
      border-radius: 8px;
      display: grid;
      place-items: center;
      color: #fff;
      font-size: 0.85rem;
      font-weight: 900;
    }
    .nav-links { display: flex; gap: 26px; align-items: center; }
    .nav-links a {
      color: var(--muted);
      font-size: 0.95rem;
      font-weight: 600;
      padding: 6px 0;
      border-bottom: 2px solid transparent;
      text-decoration: none;
    }
    .nav-links a:hover { color: var(--text); border-bottom-color: var(--accent); text-decoration: none; }
    .nav-links a.active { color: var(--accent); border-bottom-color: var(--accent); }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid transparent;
      border-radius: var(--radius);
      padding: 10px 20px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.15s ease, filter 0.25s ease;
      text-decoration: none;
    }
    .btn:active { transform: translateY(-1px); }
    .btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
    .btn-primary:hover { filter: brightness(1.15); }
    .btn-outline { background: transparent; color: var(--text); border-color: var(--border); }
    .btn-outline:hover { border-color: var(--text); background: rgba(255,255,255,0.04); }
    .btn-danger { background: var(--err); color: #fff; border-color: var(--err); }
    .btn-sm { padding: 6px 12px; font-size: 0.85rem; }
    .flash {
      margin-bottom: 16px;
      padding: 12px 16px;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      background: var(--panel);
      color: var(--text);
      font-size: 0.9rem;
    }
    .flash--error { border-color: var(--err); color: var(--err); background: rgba(239, 68, 68, 0.08); }
    main { padding: 40px 0 90px; }
    footer {
      padding: 48px 0 24px;
      color: var(--muted);
      font-size: 0.85rem;
      text-align: center;
      border-top: 1px solid var(--border);
    }
    .card {
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 700;
      white-space: nowrap;
    }
    .badge--operational { background: rgba(16, 185, 129, 0.12); color: var(--ok); border: 1px solid rgba(16, 185, 129, 0.25); }
    .badge--degraded { background: rgba(245, 158, 11, 0.12); color: var(--warn); border: 1px solid rgba(245, 158, 11, 0.25); }
    .badge--outage { background: rgba(239, 68, 68, 0.12); color: var(--err); border: 1px solid rgba(239, 68, 68, 0.25); }
    .badge--maintenance { background: rgba(100, 116, 139, 0.12); color: #94a3b8; border: 1px solid rgba(100, 116, 139, 0.25); }
    .form-group { margin-bottom: 16px; }
    .form-group label { display: block; color: var(--muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 6px; letter-spacing: 0.02em; }
    .form-group input { width: 100%; background: #050708; border: 1px solid var(--border); border-radius: var(--radius); padding: 11px 14px; color: var(--text); font-size: 0.95rem; }
    .form-group input:focus { outline: none; border-color: var(--accent); }
    .section-title { font-size: 0.85rem; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 14px; }
    @media (max-width: 640px) {
      .nav-links { gap: 18px; }
      .nav-links a { font-size: 0.9rem; padding: 4px 0; }
    }
    /* Tiny animated gradient button */
    .tiny-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
      position: relative;
      height: 30px;
      padding: 1px;
      border-radius: 9999px;
      overflow: hidden;
      background: #050708;
      cursor: pointer;
      text-decoration: none;
      border: none;
    }
    .tiny-btn .glow-wrap {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      overflow: hidden;
    }
    .tiny-btn .gradient-blur {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      width: 22px;
      height: 22px;
      left: 50%;
      top: 35%;
      transform: translate(-50%, -35%);
      filter: blur(14px);
      background: linear-gradient(135deg, #7A69F9, #F26378, #F5833F);
      opacity: 0.55;
    }
    .tiny-btn .border-glow {
      position: absolute;
      inset: 0;
      border-radius: inherit;
      animation: border-glow-translate 10s ease-in-out infinite alternate;
    }
    .tiny-btn .border-glow span {
      position: absolute;
      inset: 0;
      width: 10px;
      height: 100%;
      left: 50%;
      transform: translateX(-50%);
      border-radius: inherit;
      filter: blur(14px);
      animation: border-glow-scale 10s ease-in-out infinite alternate;
      background: linear-gradient(135deg, #7A69F9, #F26378, #F5833F);
    }
    .tiny-btn .content {
      position: relative;
      z-index: 1;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 5px;
      height: 28px;
      padding: 0 14px 0 8px;
      border-radius: inherit;
      background: rgba(255,255,255,0.05);
      backdrop-filter: blur(4px);
      border: 1px solid rgba(255,255,255,0.06);
    }
    .tiny-btn .icon-wrap {
      position: relative;
      width: 16px;
      height: 16px;
      animation: star-rotate 14s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite alternate;
    }
    .tiny-btn .icon-wrap svg { width: 16px; height: 16px; opacity: 0.85; }
    .tiny-btn .icon-wrap .shine {
      position: absolute;
      inset: 50%;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      opacity: 0.25;
      background: linear-gradient(135deg, #3BC4F2, #7A69F9, #F26378, #F5833F);
      filter: blur(7px);
      animation: star-shine 14s ease-in-out infinite alternate;
      transform: translate(-50%, -50%);
    }
    .tiny-btn .label {
      margin-left: 6px;
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: #fff;
      animation: star-rotate 14s cubic-bezier(0.68, -0.55, 0.27, 1.55) infinite alternate;
      white-space: nowrap;
    }
    .tiny-btn:hover .icon-wrap,
    .tiny-btn:hover .label {
      animation: none;
      transform: scale(1.05) rotate(0deg);
    }
    @keyframes border-glow-translate { from { transform: translateX(0); } to { transform: translateX(14px); } }
    @keyframes border-glow-scale { from { transform: translateX(-50%) scale(1); } to { transform: translateX(-50%) scale(1.15); } }
    @keyframes star-rotate { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
    @keyframes star-shine { from { opacity: 0.15; transform: translate(-50%, -50%) scale(1); } to { opacity: 0.45; transform: translate(-50%, -50%) scale(1.25); } }
  </style>
</head>
<body>
  <header>
    <nav class="navbar container">
      <a class="brand" href="/"><div class="mark">E</div>EasySupport</a>
      <div class="nav-links">
        <a href="/" class="<%= active === 'home' ? 'active' : '' %>">Home</a>
        <a href="/status" class="<%= active === 'status' ? 'active' : '' %>">Status</a>
        <% if (admin) { %><a href="/admin" class="btn btn-outline btn-sm">Admin</a><a href="/admin/logout" class="btn btn-danger btn-sm">Logout</a><% } else { %><a href="/admin/login" class="btn btn-outline btn-sm">Admin</a><% } %>
      </div>
    </nav>
  </header>

  <main class="container">
    <% if (message) { %>
      <div class="flash"><%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="flash flash--error"><%= error %></div>
    <% } %>
    <%- body %>
  </main>

  <footer>
    EasySupport &mdash; self-hosted Discord ticketing bot. <a href="<%= repoUrl || 'https://github.com/Marcel1kub1/EasySupport' %>" target="_blank" rel="noopener">GitHub</a>
  </footer>
</body>
</html>
