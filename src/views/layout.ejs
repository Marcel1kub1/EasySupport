<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #0b0c10;
      --panel: #13151c;
      --panel-hover: #191b25;
      --border: #22242e;
      --text: #e8eaed;
      --muted: #8e93a1;
      --accent: #5865f2;
      --accent-hover: #4752c4;
      --ok: #3ba55d;
      --warn: #faa81a;
      --err: #ed4245;
      --radius: 12px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--ink);
      color: var(--text);
      font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      line-height: 1.55;
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
    }
    a { color: var(--accent); text-decoration: none; }
    a:hover { color: var(--accent-hover); text-decoration: underline; }
    :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .container { max-width: 1000px; margin: 0 auto; padding: 0 20px; }
    header {
      position: sticky;
      top: 0;
      z-index: 50;
      border-bottom: 1px solid var(--border);
    }
    .navbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      height: 64px;
      padding: 0 20px;
      background: rgba(11, 12, 16, 0.6);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 700;
      font-size: 1.15rem;
      letter-spacing: -0.5px;
      color: var(--text);
    }
    .brand .mark {
      width: 28px;
      height: 28px;
      background: var(--accent);
      border-radius: 8px;
      display: grid;
      place-items: center;
      font-weight: 800;
      color: #fff;
      font-size: 0.85rem;
    }
    .nav-links {
      display: flex;
      gap: 26px;
      align-items: center;
    }
    .nav-links a {
      color: var(--muted);
      font-size: 0.95rem;
      font-weight: 500;
      padding: 6px 0;
      border-bottom: 2px solid transparent;
      text-decoration: none;
    }
    .nav-links a:hover { color: var(--text); text-decoration: none; border-bottom-color: var(--accent); }
    .nav-links a.active { color: var(--accent); border-bottom-color: var(--accent); }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid transparent;
      border-radius: var(--radius);
      padding: 10px 18px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
      text-decoration: none;
    }
    .btn:active { transform: translateY(-1px); }
    .btn-primary { background: var(--accent); color: #fff; border-color: var(--accent); }
    .btn-primary:hover { background: var(--accent-hover); border-color: var(--accent-hover); }
    .btn-outline { background: transparent; color: var(--text); border-color: var(--border); }
    .btn-outline:hover { border-color: var(--text); background: rgba(255,255,255,0.03); }
    .btn-danger { background: var(--err); color: #fff; border-color: var(--err); }
    .btn-sm { padding: 6px 12px; font-size: 0.85rem; }
    .flash {
      margin-bottom: 16px;
      padding: 12px 16px;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      background: var(--panel);
      color: var(--text);
      font-size: 0.9rem;
    }
    .flash--error { border-color: var(--err); color: var(--err); background: rgba(237, 66, 69, 0.08); }
    main { padding: 40px 0 80px; }
    footer {
      padding: 48px 0 24px;
      color: var(--muted);
      font-size: 0.85rem;
      text-align: center;
      border-top: 1px solid var(--border);
    }
    @media (max-width: 640px) {
      .nav-links { gap: 18px; }
      .nav-links a { font-size: 0.9rem; padding: 4px 0; }
    }
    @media (prefers-reduced-motion: reduce) {
      * { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
    }
  </style>
</head>
<body>
  <header>
    <nav class="navbar container">
      <a class="brand" href="/"><div class="mark">E</div>EasySupport</a>
      <div class="nav-links">
        <a href="/" class="<%= active === 'home' ? 'active' : '' %>">Home</a>
        <a href="/status" class="<%= active === 'status' ? 'active' : '' %>">Status</a>
        <% if (admin) { %><a href="/admin/logout" class="btn btn-danger btn-sm">Logout</a><% } else { %><a href="/admin/login" class="btn btn-outline btn-sm">Admin</a><% } %>
      </div>
    </nav>
  </header>

  <main class="container">
    <% if (message) { %>
      <div class="flash"><%= message %></div>
    <% } %>
    <% if (error) { %>
      <div class="flash flash--error"><%= error %></div>
    <% } %>
    <%- body %>
  </main>

  <footer>
    EasySupport &mdash; self-hosted Discord ticketing bot. <a href="<%= repoUrl || 'https://github.com/Marcel1kub1/EasySupport' %>" target="_blank" rel="noopener">GitHub</a>
  </footer>
</body>
</html>
