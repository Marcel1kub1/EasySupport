<section class="login">
  <div class="login-card">
    <h2>Admin login</h2>
    <% if (error) { %>
      <div class="flash flash--error"><%= error %></div>
    <% } %>
    <form method="post" action="/admin/login">
      <div class="form-group">
        <label>Username</label>
        <input name="user" required autofocus>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input name="pass" type="password" required>
      </div>
      <button class="btn btn-primary" style="width: 100%;">Sign in</button>
    </form>
    <p class="muted" style="margin-top: 16px; font-size: 0.88rem; text-align: center;">
      Only an admin can change the system status or post announcements. The status page itself is public.
    </p>
  </div>
</section>

<style>
  .login { display: flex; align-items: center; justify-content: center; min-height: 56vh; padding: 40px 0; }
  .login-card { width: 100%; max-width: 400px; background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 32px; }
  .login h2 { margin-bottom: 20px; font-size: 1.25rem; }
  .form-group { margin-bottom: 16px; }
  .form-group label { display: block; color: var(--muted); font-size: 0.9rem; margin-bottom: 6px; }
  .form-group input { width: 100%; background: #0f1116; border: 1px solid var(--border); border-radius: var(--radius); padding: 10px 14px; color: var(--text); font-size: 0.95rem; }
  .form-group input:focus { outline: none; border-color: var(--accent); }
  @media (max-width: 480px) {
    .login-card { padding: 24px; }
  }
</style>
