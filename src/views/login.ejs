<section class="login reveal">
  <div class="login-card card reveal">
    <h2 class="reveal">Admin login</h2>
    <% if (error) { %>
      <div class="flash flash--error reveal"><%= error %></div>
    <% } %>
    <form method="post" action="/admin/login">
      <div class="form-group reveal">
        <label>Username</label>
        <input name="user" required autofocus>
      </div>
      <div class="form-group reveal">
        <label>Password</label>
        <input name="pass" type="password" required>
      </div>
      <button class="btn btn-primary reveal" style="width: 100%;">Sign in</button>
    </form>
    <p class="muted reveal" style="margin-top: 18px; font-size: 0.85rem; text-align: center;">
      Only an admin can change the system status or post announcements. The status page itself is public.
    </p>
  </div>
</section>

<style>
  .login { display: flex; align-items: center; justify-content: center; min-height: 60vh; padding: 40px 0; }
  .login-card { width: 100%; max-width: 400px; padding: 32px 28px; }
  .login h2 { margin-bottom: 6px; font-size: 1.4rem; font-weight: 800; letter-spacing: -0.02em; }
  @media (max-width: 480px) {
    .login-card { padding: 24px 20px; }
  }
</style>
