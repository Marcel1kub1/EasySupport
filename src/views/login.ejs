<section style="margin-top: 30px;">
  <div class="form">
    <h2>Admin login</h2>
    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>
    <form method="post" action="/admin/login">
      <div class="form-group">
        <label>Username</label>
        <input name="user" required autofocus>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input name="pass" type="password" required>
      </div>
      <button class="btn btn-primary" style="width: 100%;">Sign in</button>
    </form>
    <p class="muted" style="margin-top: 16px; font-size: 0.88rem; text-align: center;">
      Only an admin can change the system status or post announcements. The status page itself is public.
    </p>
  </div>
</section>
