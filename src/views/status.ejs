<% if (notFound) { %>
  <section class="not-found">
    <h1>404 &mdash; Not Found</h1>
    <p class="muted">The page you&rsquo;re looking for doesn&rsquo;t exist.</p>
    <a href="/" class="btn btn-outline">Back to home</a>
  </section>
<% } else { %>
  <section class="status-header">
    <div class="status-stack">
      <h1>EasySupport Status</h1>
      <div class="overall">
        <span class="dot dot--<%= overallStatus %>"></span>
        <span><%= overallLabel %></span>
      </div>
    </div>
    <% if (admin) { %>
      <form method="post" action="/admin/status" class="status-form">
        <input name="status_text" placeholder="New status message" required>
        <button class="btn btn-sm btn-primary">Update status</button>
      </form>
    <% } %>
  </section>

  <section class="components">
    <h2 class="section-title">Components</h2>
    <div class="component-grid">
      <% components.forEach((c) => { %>
        <div class="component-card">
          <div class="component-info">
            <span class="component-name"><%= c.name %></span>
            <span class="component-desc"><%= c.desc %></span>
          </div>
          <span class="badge badge--<%= c.status %>"><%= c.label %></span>
        </div>
      <% }) %>
    </div>
  </section>

  <% if (announcements.length) { %>
    <section class="announcements">
      <h2 class="section-title">Announcements</h2>
      <% announcements.forEach((a) => { %>
        <div class="announce">
          <div class="announce-title"><%= a.title %></div>
          <div class="announce-content"><%= a.content %></div>
        </div>
      <% }) %>
    </section>
  <% } %>

  <% if (admin) { %>
    <section class="admin-form">
      <h2 class="section-title">Post announcement</h2>
      <form method="post" action="/admin/announce" class="form">
        <div class="form-group">
          <label>Title</label>
          <input name="title" required placeholder="e.g. Maintenance tonight">
        </div>
        <div class="form-group">
          <label>Content</label>
          <input name="content" required placeholder="What&rsquo;s happening?">
        </div>
        <button class="btn btn-primary">Post announcement</button>
      </form>
    </section>
  <% } %>
<% } %>

<style>
  .status-header { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 34px; flex-wrap: wrap; }
  .status-stack h1 { font-size: 1.75rem; font-weight: 700; letter-spacing: -0.02em; margin: 0; }
  .overall { display: flex; align-items: center; gap: 10px; font-size: 0.95rem; color: var(--muted); font-weight: 500; }
  .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .dot--operational { background: var(--ok); box-shadow: 0 0 0 4px rgba(59, 165, 93, 0.18); }
  .dot--degraded { background: var(--warn); box-shadow: 0 0 0 4px rgba(250, 168, 26, 0.18); }
  .dot--outage { background: var(--err); box-shadow: 0 0 0 4px rgba(237, 66, 69, 0.18); }
  .status-form { margin-left: auto; }
  .status-form input { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 10px 14px; color: var(--text); font-size: 0.95rem; width: 220px; }
  .components { margin-bottom: 40px; }
  .section-title { font-size: 1rem; font-weight: 600; color: var(--muted); margin-bottom: 14px; letter-spacing: -0.01em; }
  .component-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .component-card { display: flex; align-items: center; justify-content: space-between; background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 18px; }
  .component-name { color: var(--text); font-size: 0.95rem; font-weight: 600; }
  .component-desc { color: var(--muted); font-size: 0.85rem; display: block; margin-top: 2px; }
  .badge { display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px; border-radius: 999px; font-size: 0.8rem; font-weight: 600; white-space: nowrap; }
  .badge--operational { background: rgba(59, 165, 93, 0.12); color: var(--ok); border: 1px solid rgba(59, 165, 93, 0.25); }
  .badge--degraded { background: rgba(250, 168, 26, 0.12); color: var(--warn); border: 1px solid rgba(250, 168, 26, 0.25); }
  .badge--outage { background: rgba(237, 66, 69, 0.12); color: var(--err); border: 1px solid rgba(237, 66, 69, 0.25); }
  .announcements { margin-bottom: 40px; }
  .announce { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 14px 18px; margin-bottom: 12px; }
  .announce-title { font-weight: 700; color: var(--accent); margin-bottom: 4px; font-size: 0.95rem; }
  .announce-content { color: var(--text); font-size: 0.95rem; white-space: pre-wrap; }
  .admin-form { margin-bottom: 30px; }
  .form { max-width: 480px; background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 24px; }
  .form h2 { margin-bottom: 16px; font-size: 1.1rem; }
  .form-group { margin-bottom: 14px; }
  .form-group label { display: block; color: var(--muted); font-size: 0.9rem; margin-bottom: 6px; }
  .form-group input { width: 100%; background: #0f1116; border: 1px solid var(--border); border-radius: var(--radius); padding: 10px 14px; color: var(--text); font-size: 0.95rem; }
  .form-group input:focus { outline: none; border-color: var(--accent); }
  .not-found { text-align: center; padding: 60px 0; }
  .not-found h1 { font-size: 2rem; margin-bottom: 8px; }
  .not-found .muted { margin-bottom: 20px; display: inline-block; }
  @media (max-width: 640px) {
    .status-header { flex-direction: column; align-items: stretch; }
    .status-form { margin-left: 0; margin-top: 14px; }
    .status-form input { width: 100%; }
  }
</style>
