<% if (notFound) { %>
  <section class="not-found">
    <h1 style="font-size: 2.2rem; margin-bottom: 10px;">404 &mdash; Not Found</h1>
    <p style="color: var(--muted); margin-bottom: 24px; display: inline-block;">The page you&rsquo;re looking for doesn&rsquo;t exist.</p>
    <a href="/" class="btn btn-outline">Back to home</a>
  </section>
<% } else { %>
  <section class="status-header">
    <div class="status-stack">
      <h1 style="font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; margin: 0;">EasySupport Status</h1>
      <div class="overall">
        <span class="dot dot--<%= overallStatus %>"></span>
        <span style="color: var(--muted); font-weight: 600; font-size: 0.95rem;"><%= overallLabel %></span>
      </div>
    </div>
    <% if (admin) { %>
      <div class="admin-note" style="color: var(--muted); font-size: 0.85rem; font-weight: 600; margin-left: auto;">
        Manage status and announcements → <a href="/admin" style="color: var(--accent); text-decoration: underline;">Admin page</a>
      </div>
    <% } %>
  </section>

  <section class="components" style="margin-bottom: 40px;">
    <div class="section-title">Components</div>
    <div class="component-grid">
      <% components.forEach((c) => { %>
        <div class="component-card card">
          <div class="component-info">
            <span class="component-name" style="color: var(--text); font-size: 0.95rem; font-weight: 700;"><%= c.name %></span>
            <span class="component-desc" style="color: var(--muted); font-size: 0.82rem; display: block; margin-top: 2px;"><%= c.desc %></span>
          </div>
          <span class="badge badge--<%= c.status %>"><%= c.label %></span>
        </div>
      <% }) %>
    </div>
  </section>

  <section class="announcements" style="margin-bottom: 40px;">
    <div class="section-title">Status announcements</div>
    <div class="announcements-hardcoded" style="display: flex; flex-direction: column; gap: 12px; max-width: 600px;">
      <div class="announce card announce--info">
        <div class="announce-row" style="display: flex; align-items: center; gap: 12px;">
          <div class="announce-icon" style="width: 24px; height: 24px; border-radius: 8px; background: rgba(88, 101, 242, 0.15); color: var(--accent); display: flex; align-items: center; justify-content: center; font-size: 0.9rem; flex-shrink: 0;">🟢</div>
          <div class="announce-body">
            <div class="announce-title" style="font-weight: 800; color: var(--accent); margin-bottom: 2px; font-size: 0.9rem;">System status</div>
            <div class="announce-content" style="color: var(--text); font-size: 0.9rem; white-space: pre-wrap; line-height: 1.5;">All systems operational. Gateway, database, and API endpoints are healthy.</div>
          </div>
        </div>
      </div>
      <div class="announce card announce--warn">
        <div class="announce-row" style="display: flex; align-items: center; gap: 12px;">
          <div class="announce-icon" style="width: 24px; height: 24px; border-radius: 8px; background: rgba(245, 158, 11, 0.15); color: var(--warn); display: flex; align-items: center; justify-content: center; font-size: 0.9rem; flex-shrink: 0;">⚠️</div>
          <div class="announce-body">
            <div class="announce-title" style="font-weight: 800; color: var(--warn); margin-bottom: 2px; font-size: 0.9rem;">Scheduled maintenance</div>
            <div class="announce-content" style="color: var(--text); font-size: 0.9rem; white-space: pre-wrap; line-height: 1.5;">MySQL maintenance window tonight 02:00–04:00 UTC. Brief blips possible during failover.</div>
          </div>
        </div>
      </div>
      <div class="announce card announce--feature">
        <div class="announce-row" style="display: flex; align-items: center; gap: 12px;">
          <div class="announce-icon" style="width: 24px; height: 24px; border-radius: 8px; background: rgba(122, 105, 249, 0.15); color: #7A69F9; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; flex-shrink: 0;">✨</div>
          <div class="announce-body">
            <div class="announce-title" style="font-weight: 800; color: #7A69F9; margin-bottom: 2px; font-size: 0.9rem;">New feature</div>
            <div class="announce-content" style="color: var(--text); font-size: 0.9rem; white-space: pre-wrap; line-height: 1.5;">High-rank DM module is now live. Use /setup to configure per-guild module toggles.</div>
          </div>
        </div>
      </div>
    </div>
  </section>
<% } %>

<style>
  .status-header { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 34px; flex-wrap: wrap; }
  .overall { display: flex; align-items: center; gap: 10px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .dot--operational { background: var(--ok); box-shadow: 0 0 0 5px rgba(16, 185, 129, 0.25); }
  .dot--degraded { background: var(--warn); box-shadow: 0 0 0 5px rgba(245, 158, 11, 0.25); }
  .dot--outage { background: var(--err); box-shadow: 0 0 0 5px rgba(239, 68, 68, 0.25); }
  .dot--maintenance { background: #94a3b8; box-shadow: 0 0 0 5px rgba(100, 116, 139, 0.25); }
  .status-form { margin-left: auto; display: flex; gap: 8px; align-items: center; }
  .component-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; }
  .component-card { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px; }
  .component-name { color: var(--text); font-size: 0.95rem; font-weight: 700; }
  .component-desc { color: var(--muted); font-size: 0.82rem; display: block; margin-top: 2px; }
  .announce { padding: 14px 18px; margin-bottom: 12px; position: relative; overflow: hidden; }
  .announce::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    border-radius: 0 4px 4px 0;
  }
  .announce--info::before { background: var(--accent); }
  .announce--warn::before { background: var(--warn); }
  .announce--feature::before { background: #7A69F9; }
  .announce-row { display: flex; align-items: center; gap: 12px; }
  .announce-icon {
    width: 24px; height: 24px; border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.9rem; flex-shrink: 0;
  }
  .announce-body { flex: 1; min-width: 0; }
  .announce-title { font-weight: 800; margin-bottom: 2px; font-size: 0.9rem; }
  .announce-content { color: var(--text); font-size: 0.9rem; white-space: pre-wrap; line-height: 1.5; opacity: 0.9; }
  .announce--info .announce-title { color: var(--accent); }
  .announce--warn .announce-title { color: var(--warn); }
  .announce--feature .announce-title { color: #7A69F9; }
  .not-found { text-align: center; padding: 80px 0; }
  .not-found h1 { font-size: 2.2rem; margin-bottom: 10px; }
  @media (max-width: 640px) {
    .status-header { flex-direction: column; align-items: stretch; }
    .status-form { margin-left: 0; margin-top: 14px; width: 100%; flex-direction: column; }
    .status-form input { width: 100%; }
  }
</style>
