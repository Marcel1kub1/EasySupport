<% if (notFound) { %>
  <section class="not-found reveal">
    <h1 class="reveal">404 &mdash; Not Found</h1>
    <p class="muted reveal">The page you&rsquo;re looking for doesn&rsquo;t exist.</p>
    <a href="/" class="btn btn-outline reveal">Back to home</a>
  </section>
<% } else { %>
  <section class="status-header reveal">
    <div class="status-stack">
      <h1 class="reveal">EasySupport Status</h1>
      <div class="overall reveal">
        <span class="dot dot--<%= overallStatus %>"></span>
        <span><%= overallLabel %></span>
      </div>
    </div>
    <% if (admin) { %>
      <form method="post" action="/admin/status" class="status-form reveal">
        <input name="status_text" placeholder="New status message" required>
        <button class="btn btn-sm btn-primary">Update status</button>
      </form>
    <% } %>
  </section>

  <section class="components reveal">
    <div class="section-title reveal">Components</div>
    <div class="component-grid">
      <% components.forEach((c) => { %>
        <div class="component-card card reveal">
          <div class="component-info">
            <span class="component-name"><%= c.name %></span>
            <span class="component-desc"><%= c.desc %></span>
          </div>
          <span class="badge badge--<%= c.status %>"><%= c.label %></span>
        </div>
      <% }) %>
    </div>
  </section>

  <% if (announcements.length) { %>
    <section class="announcements reveal">
      <div class="section-title reveal">Announcements</div>
      <% announcements.forEach((a) => { %>
        <div class="announce card reveal">
          <div class="announce-title"><%= a.title %></div>
          <div class="announce-content"><%= a.content %></div>
        </div>
      <% }) %>
    </section>
  <% } %>

  <% if (admin) { %>
    <section class="admin-form reveal">
      <div class="section-title reveal">Post announcement</div>
      <form method="post" action="/admin/announce" class="form reveal">
        <div class="form-group reveal">
          <label>Title</label>
          <input name="title" required placeholder="e.g. Maintenance tonight">
        </div>
        <div class="form-group reveal">
          <label>Content</label>
          <input name="content" required placeholder="What&rsquo;s happening?">
        </div>
        <button class="btn btn-primary reveal">Post announcement</button>
      </form>
    </section>
  <% } %>
<% } %>

<style>
  .status-header { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 34px; flex-wrap: wrap; }
  .status-stack h1 { font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; margin: 0; }
  .overall { display: flex; align-items: center; gap: 10px; font-size: 0.95rem; color: var(--muted); font-weight: 600; }
  .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .dot--operational { background: var(--ok); box-shadow: 0 0 0 5px rgba(59, 165, 93, 0.18); }
  .dot--degraded { background: var(--warn); box-shadow: 0 0 0 5px rgba(250, 168, 26, 0.18); }
  .dot--outage { background: var(--err); box-shadow: 0 0 0 5px rgba(237, 66, 69, 0.18); }
  .status-form { margin-left: auto; display: flex; gap: 8px; align-items: center; }
  .status-form input { background: var(--panel); border: 1px solid var(--border); border-radius: var(--radius); padding: 10px 14px; color: var(--text); font-size: 0.95rem; width: 240px; }
  .components { margin-bottom: 40px; }
  .component-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 14px; }
  .component-card { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px; }
  .component-name { color: var(--text); font-size: 0.95rem; font-weight: 700; }
  .component-desc { color: var(--muted); font-size: 0.82rem; display: block; margin-top: 2px; }
  .announcements { margin-bottom: 40px; }
  .announce { padding: 16px 20px; margin-bottom: 12px; }
  .announce-title { font-weight: 800; color: var(--accent); margin-bottom: 4px; font-size: 0.95rem; }
  .announce-content { color: var(--text); font-size: 0.95rem; white-space: pre-wrap; }
  .admin-form { margin-bottom: 30px; }
  .form { max-width: 520px; }
  .not-found { text-align: center; padding: 80px 0; }
  .not-found h1 { font-size: 2.2rem; margin-bottom: 10px; }
  .not-found .muted { display: inline-block; margin-bottom: 24px; }
  @media (max-width: 640px) {
    .status-header { flex-direction: column; align-items: stretch; }
    .status-form { margin-left: 0; margin-top: 14px; width: 100%; flex-direction: column; }
    .status-form input { width: 100%; }
  }
</style>
