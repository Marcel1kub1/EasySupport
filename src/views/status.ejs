<% if (notFound) { %>
  <div style="text-align:center; padding: 40px 0;">
    <h1 style="font-size: 2rem; margin-bottom: 8px;">404 — Not Found</h1>
    <p class="muted" style="margin-bottom: 20px;">The page you're looking for doesn't exist.</p>
    <a href="/" class="btn btn-outline">Back to home</a>
  </div>
<% } else { %>
  <section style="margin-bottom: 30px;">
    <div class="cta">
      <h2>System status</h2>
      <span class="badge <%= (status?.status_text || '').toLowerCase().includes('operational') ? 'badge-operational' : 'badge-degraded' %>">
        <%= status?.status_text || 'No status set' %>
      </span>
      <% if (admin) { %>
        <form method="post" action="/admin/status" style="margin-top:14px; display:flex; gap:8px; flex-wrap:wrap;">
          <input name="status_text" placeholder="New status message" required style="flex:1; min-width:200px;">
          <button class="btn btn-primary btn-sm">Update</button>
        </form>
        <form method="get" action="/admin/logout" style="margin-top:10px;">
          <button class="btn btn-outline btn-sm">Logout</button>
        </form>
      <% } else { %>
        <a href="/admin/login" class="btn btn-outline btn-sm" style="margin-top:14px;">Admin login</a>
      <% } %>
    </div>
  </section>

  <% if (announcements.length) { %>
    <section class="muted" style="margin-bottom: 30px;">
      <h3 style="margin-bottom: 10px; font-size: 1rem;">Announcements</h3>
      <% announcements.forEach((a) => { %>
        <div class="announce">
          <div class="title"><%= a.title %></div>
          <div class="content"><%= a.content %></div>
        </div>
      <% }) %>
    </section>
  <% } %>

  <div class="grid-2">
    <section class="card">
      <h3>System metrics</h3>
      <% if (metrics) { %>
        <table>
          <tbody>
            <tr>
              <td>API</td>
              <td><span class="badge badge-operational"><%= metrics.apiStatus %></span></td>
            </tr>
            <tr>
              <td>Database</td>
              <td><span class="badge <%= metrics.dbStatus === 'connected' ? 'badge-operational' : 'badge-degraded' %>"><%= metrics.dbStatus %></span></td>
            </tr>
            <tr>
              <td>Uptime</td>
              <td><%= metrics.uptimeFormatted %></td>
            </tr>
            <tr>
              <td>Memory</td>
              <td><%= metrics.memoryUsedMB %> MB / <%= metrics.memoryTotalMB %> MB</td>
            </tr>
            <tr>
              <td>CPU cores</td>
              <td><%= metrics.cpuCount %></td>
            </tr>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty">Metrics unavailable.</div>
      <% } %>
    </section>

    <section class="card">
      <h3>About</h3>
      <p>EasySupport is a self-hosted Discord ticketing bot. The website and the bot run in a single process on one host, sharing a MySQL database.</p>
      <p class="muted" style="font-size: 0.85rem;">
        Status page is public. Only an admin can change the system status or post announcements.
      </p>
    </section>
  </div>

  <% if (admin) { %>
    <section class="card" style="margin-top: 20px;">
      <h3>Post announcement</h3>
      <form method="post" action="/admin/announce">
        <div class="form-group">
          <label>Title</label>
          <input name="title" required placeholder="e.g. Maintenance tonight">
        </div>
        <div class="form-group">
          <label>Content</label>
          <input name="content" required placeholder="What's happening?">
        </div>
        <button class="btn btn-primary">Post announcement</button>
      </form>
    </section>
  <% } %>
<% } %>
