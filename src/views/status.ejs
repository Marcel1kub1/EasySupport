<% if (notFound) { %>
  <section class="not-found">
    <p class="section-kicker">Page not found</p>
    <h1>That page isn’t here.</h1>
    <p>Try heading back to the EasySupport home page.</p>
    <a href="/" class="button button--primary">Back to home</a>
  </section>
<% } else { %>
  <section class="status-page" aria-labelledby="status-heading">
    <header class="page-heading status-heading">
      <div>
        <p class="section-kicker">Service information</p>
        <h1 id="status-heading">System status</h1>
        <div class="overall-status">
          <span class="status-light status-light--<%= overallStatus %>" aria-hidden="true"></span>
          <span><%= overallLabel %></span>
        </div>
      </div>
      <% if (admin) { %>
        <a class="text-link" href="/admin">Manage status and updates <span aria-hidden="true">↗</span></a>
      <% } %>
    </header>

    <section class="status-section" aria-labelledby="components-heading">
      <div class="section-heading">
        <h2 id="components-heading">Service components</h2>
        <p>Current health of the services behind EasySupport.</p>
      </div>
      <div class="component-list">
        <% components.forEach((component) => { %>
          <article class="component-row">
            <div>
              <h3><%= component.name %></h3>
              <p><%= component.desc %></p>
            </div>
            <span class="component-state component-state--<%= component.status %>">
              <span class="status-light status-light--<%= component.status %>" aria-hidden="true"></span>
              <%= component.label %>
            </span>
          </article>
        <% }) %>
      </div>
    </section>

    <section class="status-section" aria-labelledby="updates-heading">
      <div class="section-heading">
        <h2 id="updates-heading">Status updates</h2>
        <p>Notices from the EasySupport team.</p>
      </div>
      <% if (announcements && announcements.length) { %>
        <div class="announcement-list">
          <% announcements.forEach((announcement) => { %>
            <%
              var titleLower = announcement.title.toLowerCase();
              var announcementTone = 'incident';
              if (titleLower.includes('operational') || titleLower.includes('all systems')) {
                announcementTone = 'operational';
              } else if (titleLower.includes('maintenance') || titleLower.includes('scheduled')) {
                announcementTone = 'maintenance';
              } else if (titleLower.includes('feature')) {
                announcementTone = 'feature';
              }
            %>
            <article class="announcement announcement--<%= announcementTone %>">
              <span class="announcement-mark" aria-hidden="true"></span>
              <div>
                <h3><%= announcement.title %></h3>
                <p><%= announcement.content %></p>
              </div>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <p class="empty-state">There are no status updates right now.</p>
      <% } %>
    </section>
  </section>
<% } %>
