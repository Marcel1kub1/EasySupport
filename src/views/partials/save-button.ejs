<div class="save-button-wrapper">
  <button class="save-button" type="submit" data-save-button data-save-state="idle" data-default-label="Save <%= settingName %> settings" aria-label="Save <%= settingName %> settings">
    <span class="save-button__text" aria-hidden="true">
      <span class="save-button__state save-button__state--idle">Save changes</span>
      <span class="save-button__state save-button__state--saving">Saving</span>
      <span class="save-button__state save-button__state--saved">Saved</span>
      <span class="save-button__state save-button__state--error">Try again</span>
    </span>
    <span class="save-button__icon" aria-hidden="true">
      <svg class="save-button__arrow" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 12h15"/>
        <path d="m13 6 6 6-6 6"/>
      </svg>
      <svg class="save-button__check" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="m5 12 4 4L19 6"/>
      </svg>
    </span>
  </button>
</div>
