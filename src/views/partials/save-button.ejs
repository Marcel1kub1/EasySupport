<div class="btn-wrapper">
  <button class="btn" type="submit" data-save-button data-save-state="idle" data-default-label="Save <%= settingName %> settings" aria-label="Save <%= settingName %> settings">
    <span class="btn-main" aria-hidden="true">
      <span class="btn-dot"></span>
      <span class="btn-label">Save</span>
    </span>
    <span class="btn-reveal" aria-hidden="true">
      <span class="btn-reveal__label btn-reveal__label--prompt">Save?</span>
      <span class="btn-reveal__label btn-reveal__label--saved">Saved</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="btn-arrow" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12h14"/>
        <path stroke-linecap="round" stroke-linejoin="round" d="m13 6 6 6-6 6"/>
      </svg>
    </span>
  </button>
</div>
