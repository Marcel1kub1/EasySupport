<section class="permissions-page" data-guild-id="<%= guildId %>">
  <header class="page-intro page-intro--row" data-reveal>
    <div>
      <p class="eyebrow">Staff permissions · <%= guildName %></p>
      <h1><%= role.name %>.</h1>
      <p>Choose which commands this role can use. Guild administrators always bypass these settings.</p>
    </div>
    <a class="button button--quiet" href="/admin/<%= guildId %>/roles">Back to all roles <span aria-hidden="true">↗</span></a>
  </header>

  <div class="role-command-list">
    <% commands.forEach((cmd) => { %>
      <label class="role-command-row" data-role="<%= role.id %>" data-cmd="<%= cmd %>" data-command-item="<%= cmd %>" data-reveal>
        <span class="role-command-row__name"><code>/<%= cmd %></code></span>
        <span class="role-command-row__hint">Allow this role to use the command</span>
        <input type="checkbox" aria-label="Allow /<%= cmd %> for <%= role.name %>" <%= perms[cmd] ? 'checked' : '' %>>
        <span class="permission-toggle__track" aria-hidden="true"><span></span></span>
      </label>
    <% }) %>
  </div>
  <p class="sr-only" data-permission-status role="status" aria-live="polite"></p>
</section>
