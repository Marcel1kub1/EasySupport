# Discord application credentials (from Discord Developer Portal)
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-id-here
CLIENT_SECRET=your-client-secret-here
GUILD_ID=your-dev-guild-id-here

# Optional overrides:
# DB_FILE=./data/tickets.db
# TRANSCRIPT_DIR=./transcripts

# MySQL storage (required — replace with your credentials)
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=your-mysql-database

# Website port (combined bot + web process)
PORT=3000

# The web server trusts one reverse proxy for X-Forwarded-For.

# Express session secret (change this in production)
SESSION_SECRET=your-session-secret-here

# Discord OAuth2 redirect URI (must match Discord Developer Portal)
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# OAuth2 scopes (identify + guilds to list manageable servers)
OAUTH_SCOPE=identify guilds

# Public, read-only EasyVStatus health endpoint is enabled without a token.
# Status page destination (EasySupport /status redirect)
STATUS_URL=https://easyvstatus.wisp.uno
# Optional logical cluster label. This does not orchestrate bots or proxy Discord traffic.
CLUSTER_ID=primary
CLUSTER_NAME=Primary node
CLUSTER_REGION=Single-server deployment
CLUSTER_ENDPOINT=/healthz

# Data retention (days) for automatic deletion of closed tickets and logs
DATA_RETENTION_DAYS=90

# Impressum (legal notice) content, configurable via environment variable
# HTML is supported. Required by European Law (Impressumspflicht).
IMPRESSUM_CONTENT=<strong>EasySupport</strong><br>Self-hosted Discord support ticket bot<br>Contact: imprint@example.com
IMPRESSUM_LINK_TEXT=Impressum
PRIVACY_LINK_TEXT=Datenschutz
TERMS_LINK_TEXT=AGB

# Impressum provider details (individual fields)
IMPRESSUM_PROVIDER_NAME=EasySupport
IMPRESSUM_PROVIDER_ADDRESS=
IMPRESSUM_PROVIDER_CITY=
IMPRESSUM_PROVIDER_COUNTRY=
IMPRESSUM_PROVIDER_EMAIL=imprint@example.com
IMPRESSUM_PROVIDER_PHONE=
IMPRESSUM_TRADE_REGISTER=
IMPRESSUM_VAT_ID=
