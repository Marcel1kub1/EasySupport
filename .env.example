DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-id-here
GUILD_ID=your-dev-guild-id-here
# Optional overrides:
# DB_FILE=./data/tickets.db
# TRANSCRIPT_DIR=./transcripts

# MySQL storage (required — replace with your credentials)
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=your-mysql-user
MYSQL_PASSWORD=your-mysql-password
MYSQL_DATABASE=your-mysql-database

# Website admin credentials (admin can change status / post announcements)
ADMIN_USER=admin
ADMIN_PASSWORD=your-admin-password-here

# Express session secret (change this in production)
SESSION_SECRET=your-session-secret-here

# Website port (combined bot + web process)
PORT=3000

# Dashboard URL (for email links, redirects, etc.)
DASHBOARD_URL=http://localhost:3000

# Feature flags (set to 'false' to disable a module)
FEATURE_TICKETS=true
FEATURE_MODERATION=true
FEATURE_ANTI_NUKE=true
FEATURE_AUTOMOD=true
FEATURE_LEVELING=true
FEATURE_ECONOMY=true
FEATURE_GIVEAWAYS=true
FEATURE_VOUCHES=true
FEATURE_WELCOME_GOODBYE_BOOST=true
FEATURE_LOGGING=true
